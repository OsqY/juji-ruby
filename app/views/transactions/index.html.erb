<div class="chaotic-container">
  <div class="index-header">
    <h1 class="chaotic-title">FLUJO DE<br>CAJA</h1>
    <%= link_to "REGISTRAR +", new_transaction_path, class: "btn-chaos" %>
  </div>

  <div class="report-grid" style="margin-bottom: 5rem;">
    <div class="report-column">
      <div class="report-section-block" style="background: var(--income-bg); color: var(--income-text);">
        <span class="section-label" style="background: var(--income-text); color: var(--income-bg);">INGRESOS</span>
        <h2 class="finance-sum" style="margin-top: 1rem;">L. <%= number_with_precision @income, precision: 2 %></h2>
      </div>
    </div>
    <div class="report-column">
      <div class="report-section-block" style="background: var(--expense-bg); color: var(--expense-text);">
        <span class="section-label" style="background: var(--expense-text); color: var(--expense-bg);">EGRESOS</span>
        <h2 class="finance-sum" style="margin-top: 1rem;">L. <%= number_with_precision @expenses, precision: 2 %></h2>
      </div>
    </div>
  </div>

  <section class="report-card">
    <div class="daily-header">
      <div class="daily-date">TOTAL</div>
      <div class="daily-metadata">BALANCE NETO</div>
    </div>
    <h2 class="net-balance" style="margin-top: 1rem;">
      L. <%= number_with_precision @balance, precision: 2 %>
    </h2>
  </section>

  <h2 class="section-title" style="margin-bottom: 3rem; border-bottom: 8px solid var(--ink); display: inline-block;">HISTORIAL</h2>
  
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    <% @transactions.each do |t| %>
      <div class="report-section-block history-item">
        <div>
          <span class="section-label" style="background: <%= t.income? ? 'var(--income-text)' : 'var(--expense-text)' %>; color: <%= t.income? ? 'var(--income-bg)' : 'var(--expense-bg)' %>;">
            <%= t.transaction_type.to_s.upcase %>
          </span>
          <h3 class="section-title" style="margin-top: 1rem;"><%= t.description.to_s.upcase %></h3>
          <p class="report-text" style="font-size: 0.9rem; font-weight: 700; opacity: 0.6;">
            <%= t.date.strftime("%d %B %Y").upcase %> | <%= (t.category.presence || "VARIOS").upcase %>
          </p>
        </div>
        <div class="history-amount">
          <h2 style="color: <%= t.income? ? 'var(--income-text)' : 'var(--expense-text)' %>; font-size: 2.5rem; font-family: 'Archivo Black';">
            <%= t.income? ? '+' : '-' %>L. <%= number_with_precision t.amount, precision: 2 %>
          </h2>
          <div style="margin-top: 1rem;">
            <%= button_to "ELIMINAR", transaction_path(t), 
                  method: :delete, 
                  data: { turbo_confirm: "¿Borrar este registro financiero?" }, 
                  class: "delete-btn-link",
                  style: "color: #D63031;" %>
          </div>
        </div>
      </div>
    <% end %>
    
    <% if @transactions.empty? %>
      <div class="report-section-block" style="text-align: center; opacity: 0.5;">
        <p class="report-text">NO HAY MOVIMIENTOS REGISTRADOS</p>
      </div>
    <% end %>
  </div>
</div>
