<%= turbo_frame_tag "transactions_content" do %>
  <%= render "shared/frame_flash" %>
  <div class="chaotic-container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; gap: 1rem; flex-wrap: wrap;">
      <h1 style="font-size: 3.6rem;">FLUJO DE<br>CAJA</h1>
      <%= link_to "REGISTRAR +", new_transaction_path, class: "btn-chaos", data: { turbo_frame: "_top" } %>
    </div>

    <section class="report-section-block" style="margin-bottom: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <div style="display: flex; gap: 0.5rem; align-items: center;">
          <%= link_to "← MES ANTERIOR", transactions_path(month: @previous_month.strftime("%Y-%m")), class: "nav-link" %>
          <strong style="letter-spacing: 1px;"><%= @selected_month.strftime("%B %Y").upcase %></strong>
          <%= link_to "MES SIGUIENTE →", transactions_path(month: @next_month.strftime("%Y-%m")), class: "nav-link" %>
        </div>
        <%= link_to "IR A HOY", transactions_path(month: Date.current.strftime("%Y-%m")), class: "nav-link" %>
      </div>
    </section>

    <div class="report-grid" style="margin-bottom: 2rem;">
      <div class="report-column">
        <div class="report-section-block" style="background: var(--income-bg); color: var(--income-text);">
          <span class="section-label" style="background: var(--income-text); color: var(--income-bg);">INGRESOS DEL MES</span>
          <h2 style="font-size: 2.6rem; margin-top: 1rem;">L. <%= number_with_precision @income, precision: 2 %></h2>
        </div>
      </div>
      <div class="report-column">
        <div class="report-section-block" style="background: var(--expense-bg); color: var(--expense-text);">
          <span class="section-label" style="background: var(--expense-text); color: var(--expense-bg);">EGRESOS DEL MES</span>
          <h2 style="font-size: 2.6rem; margin-top: 1rem;">L. <%= number_with_precision @expenses, precision: 2 %></h2>
        </div>
      </div>
    </div>

    <section class="report-card" style="margin-bottom: 3rem;">
      <div class="daily-header">
        <div class="daily-date">MES</div>
        <div class="daily-metadata">BALANCE NETO</div>
      </div>
      <h2 style="font-size: 4.5rem; letter-spacing: -2px; margin-top: 1rem;">
        L. <%= number_with_precision @balance, precision: 2 %>
      </h2>
    </section>

    <section class="report-section-block" style="margin-bottom: 3rem;">
      <span class="section-label" style="background: var(--accent-blue); color: white;">PRESUPUESTOS</span>
      <h2 class="section-title" style="margin-top: 1rem;">LÍMITE MENSUAL POR CATEGORÍA</h2>

      <%= form_with model: @budget, url: budgets_path(context: "transactions"), class: "budget-form" do |f| %>
        <%= f.hidden_field :month, value: @selected_month.strftime("%Y-%m-%d") %>
        <div>
          <label>Categoría</label>
          <%= f.text_field :category, placeholder: "Ej. comida" %>
        </div>
        <div>
          <label>Límite mensual</label>
          <%= f.number_field :monthly_limit, step: 0.01, min: 0.01, placeholder: "0.00" %>
        </div>
        <div style="display: flex; align-items: end;">
          <%= f.submit "GUARDAR", class: "btn-chaos", style: "padding: 0.8rem 1rem; font-size: 0.8rem;" %>
        </div>
      <% end %>

      <div class="budget-board">
        <% @budget_rows.each do |row| %>
          <% budget = row[:budget] %>
          <% percent = row[:percent] %>
          <% status = row[:status] %>
          <div class="budget-item budget-<%= status %>">
            <div class="budget-head">
              <strong><%= budget.category.to_s.upcase %></strong>
              <span>L. <%= number_with_precision row[:spent], precision: 2 %> / L. <%= number_with_precision budget.monthly_limit, precision: 2 %></span>
            </div>
            <div class="budget-track">
              <div class="budget-fill budget-fill-<%= status %>" style="width: <%= [percent, 100].min %>%;"></div>
            </div>
            <div class="budget-foot">
              <span><%= percent %>% USADO</span>
              <% if percent >= 100 %>
                <span class="budget-alert">SUPERASTE EL PRESUPUESTO</span>
              <% elsif percent >= 80 %>
                <span class="budget-alert">ALERTA: 80% ALCANZADO</span>
              <% end %>
              <%= button_to "ELIMINAR", budget_path(budget, context: "transactions"), method: :delete, class: "delete-btn-link", data: { turbo_confirm: "¿Eliminar presupuesto?" } %>
            </div>
          </div>
        <% end %>

        <% if @budget_rows.empty? %>
          <p class="report-text" style="opacity: 0.7;">Aún no hay presupuestos para este mes.</p>
        <% end %>
      </div>
    </section>

    <h2 class="section-title" style="margin-bottom: 2rem; border-bottom: 6px solid var(--ink); display: inline-block;">HISTORIAL</h2>

    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
      <% @transactions.each do |t| %>
        <div class="report-section-block" style="display: flex; justify-content: space-between; align-items: center; background: var(--paper); gap: 1rem; flex-wrap: wrap;">
          <div>
            <span class="section-label" style="background: <%= t.income? ? 'var(--income-text)' : 'var(--expense-text)' %>; color: <%= t.income? ? 'var(--income-bg)' : 'var(--expense-bg)' %>;">
              <%= t.transaction_type.to_s.upcase %>
            </span>
            <h3 class="section-title" style="margin-top: 0.8rem;"><%= t.description.to_s.upcase %></h3>
            <p class="report-text" style="font-size: 0.85rem; font-weight: 700; opacity: 0.6;">
              <%= t.date.strftime("%d %B %Y").upcase %> | <%= (t.category.presence || "VARIOS").upcase %>
            </p>
          </div>
          <div style="text-align: right;">
            <h2 style="color: <%= t.income? ? 'var(--income-text)' : 'var(--expense-text)' %>; font-size: 2rem; font-family: 'Archivo Black';">
              <%= t.income? ? '+' : '-' %>L. <%= number_with_precision t.amount, precision: 2 %>
            </h2>
            <div style="margin-top: 0.7rem;">
              <%= button_to "ELIMINAR", transaction_path(t, month: @selected_month.strftime('%Y-%m')),
                    method: :delete,
                    data: { turbo_confirm: "¿Borrar este registro financiero?" },
                    class: "delete-btn-link",
                    style: "color: #D63031;" %>
            </div>
          </div>
        </div>
      <% end %>

      <% if @transactions.empty? %>
        <div class="report-section-block" style="text-align: center; opacity: 0.5;">
          <p class="report-text">NO HAY MOVIMIENTOS REGISTRADOS</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
