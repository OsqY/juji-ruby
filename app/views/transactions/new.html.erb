<% frame_id = turbo_frame_request_id.presence || "transaction_form_content" %>
<% drawer_mode = frame_id == "transaction_form_panel" %>
<%= turbo_frame_tag frame_id do %>
<% if drawer_mode %>
<div class="inline-drawer-shell" data-controller="drawer">
  <div class="inline-drawer-backdrop" data-action="click->drawer#close"></div>
  <div class="inline-drawer-panel">
    <button type="button" class="inline-drawer-close" data-action="click->drawer#close"><%= t("common.close") %></button>
<% end %>
<div class="chaotic-container" style="max-width: 800px;">
  <div style="border-bottom: 8px solid var(--ink); margin-bottom: 4rem; padding-bottom: 1rem;">
    <h1 class="form-title"><%= t("transactions.form.title") %></h1>
  </div>

  <%= form_with(model: @transaction, data: (drawer_mode ? {} : { turbo_frame: "_top" })) do |f| %>
    
    <div class="form-group">
      <%= f.label :transaction_type, "TIPO DE FLUJO" %>
      <div class="transaction-type-cards">
        <label class="type-card-wrapper">
          <%= f.radio_button :transaction_type, "expense", checked: true %>
          <div class="type-card">
            <div class="card-label">EGRESO</div>
          </div>
        </label>
        
        <label class="type-card-wrapper">
          <%= f.radio_button :transaction_type, "income" %>
          <div class="type-card">
            <div class="card-label">INGRESO</div>
          </div>
        </label>
      </div>
    </div>

    <div class="form-group">
      <div class="report-section-block">
        <%= f.label :amount, "¿CUÁNTO DINERO (L)?" %>
        <%= f.number_field :amount, step: 0.01, placeholder: "0.00" %>
      </div>
    </div>

    <div class="form-group">
      <div class="report-section-block" style="background: var(--muted-gray);">
        <%= f.label :description, "¿POR QUÉ CONCEPTO? (DESCRIPCIÓN)" %>
        <%= f.text_area :description, placeholder: "Compra de materiales, Venta de..." %>
      </div>
    </div>

    <div class="report-grid" style="margin-bottom: 4rem;">
      <div class="report-column">
        <div class="form-group" style="margin-bottom: 0;">
          <div class="report-section-block">
            <%= f.label :date, "FECHA DEL MOVIMIENTO" %>
            <%= f.date_field :date, value: Date.today %>
          </div>
        </div>
      </div>
      <div class="report-column">
        <div class="form-group" style="margin-bottom: 0;">
          <div class="report-section-block">
            <% category_options = @category_options.to_a %>
            <% selected_category = @transaction.category.to_s.strip.downcase %>
            <% in_options = selected_category.present? && category_options.include?(selected_category) %>
            <% selected_option = in_options ? selected_category : "__new__" %>
            <% custom_value = in_options ? "" : selected_category %>

            <%= f.label :category, "CATEGORÍA / ETIQUETA" %>
            <div data-controller="category-picker">
              <%= f.hidden_field :category, value: selected_category, data: { category_picker_target: "hidden" } %>

              <%= select_tag "transaction[category_option]",
                  options_for_select([*category_options.map { |category| [category, category] }, [t("transactions.category.new"), "__new__"]], selected_option),
                  data: { category_picker_target: "select", action: "change->category-picker#selectChanged", new_value: "__new__" } %>

              <div data-category-picker-target="customWrap" style="margin-top: 0.6rem;">
                <%= text_field_tag "transaction[category_custom]", custom_value, placeholder: t("transactions.category.custom_placeholder"), data: { category_picker_target: "custom", action: "input->category-picker#customChanged" } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit t("transactions.form.submit"), class: "btn-chaos", style: "flex: 1;" %>
      <% if drawer_mode %>
        <button type="button" data-action="click->drawer#close" style="font-weight: 900; text-decoration: none; color: #D63031; background: none; border: none; cursor: pointer;"><%= t("common.cancel") %></button>
      <% else %>
        <%= link_to t("common.cancel"), transactions_path, data: { turbo_frame: "_top" }, style: "font-weight: 900; text-decoration: none; color: #D63031;" %>
      <% end %>
    </div>

  <% end %>
</div>
<% if drawer_mode %>
  </div>
</div>
<% end %>
<% end %>
