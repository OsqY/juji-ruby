<div class="chaotic-container" style="max-width: 800px;">
  <div style="border-bottom: 8px solid var(--ink); margin-bottom: 4rem; padding-bottom: 1rem;">
    <h1 class="form-title">REGISTRAR MOVIMIENTO</h1>
  </div>

  <%= form_with(model: @transaction) do |f| %>
    
    <div class="form-group">
      <%= f.label :transaction_type, "TIPO DE FLUJO" %>
      <div class="transaction-type-cards">
        <label class="type-card-wrapper">
          <%= f.radio_button :transaction_type, "expense", checked: true %>
          <div class="type-card">
            <div class="card-label">EGRESO</div>
          </div>
        </label>
        
        <label class="type-card-wrapper">
          <%= f.radio_button :transaction_type, "income" %>
          <div class="type-card">
            <div class="card-label">INGRESO</div>
          </div>
        </label>
      </div>
    </div>

    <div class="form-group">
      <div class="report-section-block">
        <%= f.label :amount, "¿CUÁNTO DINERO (L)?" %>
        <%= f.number_field :amount, step: 0.01, placeholder: "0.00" %>
      </div>
    </div>

    <div class="form-group">
      <div class="report-section-block" style="background: var(--muted-gray);">
        <%= f.label :description, "¿POR QUÉ CONCEPTO? (DESCRIPCIÓN)" %>
        <%= f.text_area :description, placeholder: "Compra de materiales, Venta de..." %>
      </div>
    </div>

    <div class="report-grid" style="margin-bottom: 4rem;">
      <div class="report-column">
        <div class="form-group" style="margin-bottom: 0;">
          <div class="report-section-block">
            <%= f.label :date, "FECHA DEL MOVIMIENTO" %>
            <%= f.date_field :date, value: Date.today %>
          </div>
        </div>
      </div>
      <div class="report-column">
        <div class="form-group" style="margin-bottom: 0;">
          <div class="report-section-block">
            <%= f.label :category, "CATEGORÍA / ETIQUETA" %>
            <%= f.text_area :category, placeholder: "Sueldo, Comida, Inversión, etc." %>
          </div>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "REGISTRAR AHORA", class: "btn-chaos", style: "flex: 1;" %>
      <%= link_to "CANCELAR", transactions_path, style: "font-weight: 900; text-decoration: none; color: #D63031;" %>
    </div>

  <% end %>
</div>
