<% content_for :hide_nav, true %>
<%= turbo_frame_tag "password_request_content" do %>
  <div class="aws-content">
    <%= render "layouts/aws_page_header", title: "RECUPERAR CONTRASEÑA",
      breadcrumbs: [["Home", root_path], ["Recuperar", nil]] %>

    <div class="aws-card" style="max-width: 600px; margin: 0 auto;">
      <div class="aws-card-header">
        <h3 class="aws-card-title">Recuperar contraseña</h3>
      </div>
      <div style="padding: 24px;">
        <% if flash[:alert] %>
          <div class="aws-alert aws-alert-danger" style="margin-bottom: 16px;">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <%= form_with url: passwords_path, data: { turbo_frame: "_top" } do |f| %>
          <div class="field">
            <%= f.label :email_address, "Correo electrónico" %>
            <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "tu@ejemplo.com", value: params[:email_address] %>
          </div>

          <%= f.submit "Enviar instrucciones", class: "aws-btn aws-btn-primary", style: "width: 100%;" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="legacy-content">
    <div class="chaotic-container" style="max-width: 600px;">
      <div style="border-bottom: 8px solid var(--ink); margin-bottom: 4rem; padding-bottom: 1rem;">
        <h1 class="form-title">RECUPERAR CONTRASEÑA</h1>
      </div>

      <% if flash[:alert] %>
        <div style="background: #FFEDED; border: 4px solid #D63031; padding: 2rem; margin-bottom: 3rem; color: #D63031; font-weight: 700;">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: passwords_path, data: { turbo_frame: "_top" } do |f| %>
        <div class="form-group">
          <%= f.label :email_address, "CORREO ELECTRÓNICO" %>
          <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "tu@ejemplo.com", value: params[:email_address] %>
        </div>

        <div class="form-actions">
          <%= f.submit "ENVIAR INSTRUCCIONES", class: "btn-chaos", style: "flex: 1;" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
