<div class="aws-content">
  <%= render "layouts/aws_page_header", title: "NUEVO FORMULARIO",
    subtitle: "Define preguntas de selección única, múltiple o respuesta libre",
    breadcrumbs: [["Home", root_path], ["Formularios", anonymous_forms_path], ["Nuevo", nil]] %>

  <div class="aws-card" style="max-width: 960px;">
    <div class="aws-card-header">
      <h3 class="aws-card-title">Nuevo formulario anónimo</h3>
    </div>
    <%= render "shared/frame_flash" %>

    <% if @anonymous_form.errors.any? %>
      <div class="aws-alert aws-alert-danger" style="margin-bottom: 16px;">
        <%= @anonymous_form.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= form_with model: @anonymous_form do |f| %>
      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-bottom: 16px;">
        <div class="field">
          <%= f.label :title, "Título del formulario" %>
          <%= f.text_field :title, placeholder: "Ej. Encuesta de satisfacción", required: true %>
        </div>
        <div class="field">
          <%= f.label :response_limit, "Límite de respuestas" %>
          <%= f.number_field :response_limit, min: 1, step: 1, required: true %>
        </div>
      </div>
      <div class="field" style="margin-bottom: 16px;">
        <%= f.label :description, "Descripción (opcional)" %>
        <%= f.text_area :description, rows: 2, placeholder: "Contexto para las personas que responderán" %>
      </div>

      <div class="aws-card" data-controller="anonymous-form-builder" style="margin-bottom: 16px;">
        <div class="aws-card-header">
          <h3 class="aws-card-title">Preguntas</h3>
          <button type="button" class="aws-btn aws-btn-secondary" style="padding: 2px 8px; font-size: 12px;" data-action="anonymous-form-builder#addQuestion">+ Agregar pregunta</button>
        </div>
        <div data-anonymous-form-builder-target="list" style="display: flex; flex-direction: column; gap: 12px; padding: 16px;">
          <%= render "question_fields", index: 0, question: @anonymous_form.questions.first %>
        </div>
        <template data-anonymous-form-builder-target="template">
          <%= render "question_fields", index: "__INDEX__", question: AnonymousFormQuestion.new(question_type: :free_text, required: true) %>
        </template>
      </div>

      <div style="display: flex; gap: 8px; align-items: center;">
        <%= f.submit "Crear formulario", class: "aws-btn aws-btn-primary" %>
        <%= link_to "Cancelar", anonymous_forms_path, class: "aws-btn aws-btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="legacy-content">
  <div class="chaotic-container" style="max-width: 960px;">
    <%= render "shared/frame_flash" %>

    <div style="border-bottom: 8px solid var(--ink); margin-bottom: 2rem; padding-bottom: 1rem;">
      <h1 class="form-title">NUEVO FORMULARIO ANÓNIMO</h1>
      <p style="font-weight: 700; opacity: 0.65;">Define preguntas de selección única, múltiple o respuesta libre.</p>
    </div>

    <% if @anonymous_form.errors.any? %>
      <div style="background: #FFEDED; border: 4px solid #D63031; padding: 2rem; margin-bottom: 3rem; color: #D63031; font-weight: 700;">
        <%= @anonymous_form.errors.full_messages.to_sentence.upcase %>
      </div>
    <% end %>

    <%= form_with model: @anonymous_form do |f| %>
      <section class="report-section-block" style="margin-bottom: 1.5rem;">
        <div class="report-grid" style="gap: 1rem;">
          <div class="report-column field">
            <%= f.label :title, "TÍTULO DEL FORMULARIO" %>
            <%= f.text_field :title, placeholder: "Ej. Encuesta de satisfacción", required: true %>
          </div>
          <div class="report-column field">
            <%= f.label :response_limit, "LÍMITE DE RESPUESTAS" %>
            <%= f.number_field :response_limit, min: 1, step: 1, required: true %>
          </div>
        </div>
        <div class="field" style="margin-top: 1rem;">
          <%= f.label :description, "DESCRIPCIÓN (OPCIONAL)" %>
          <%= f.text_area :description, rows: 2, placeholder: "Contexto para las personas que responderán" %>
        </div>
      </section>

      <section class="report-section-block" data-controller="anonymous-form-builder" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem;">
          <h2 class="section-title" style="margin: 0;">PREGUNTAS</h2>
          <button type="button" class="btn-chaos" style="padding: 0.6rem 1rem; font-size: 0.8rem;" data-action="anonymous-form-builder#addQuestion">+ AGREGAR PREGUNTA</button>
        </div>

        <div data-anonymous-form-builder-target="list" style="display: flex; flex-direction: column; gap: 1rem;">
          <%= render "question_fields", index: 0, question: @anonymous_form.questions.first %>
        </div>

        <template data-anonymous-form-builder-target="template">
          <%= render "question_fields", index: "__INDEX__", question: AnonymousFormQuestion.new(question_type: :free_text, required: true) %>
        </template>
      </section>

      <div class="form-actions">
        <%= f.submit "CREAR FORMULARIO", class: "btn-chaos", style: "flex: 1;" %>
        <%= link_to "CANCELAR", anonymous_forms_path, style: "font-weight: 900; text-decoration: none; color: #D63031;" %>
      </div>
    <% end %>
  </div>
</div>
