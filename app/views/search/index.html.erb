<div class="chaotic-container">
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">BÚSQUEDA GLOBAL</h1>
    
    <div 
      class="search-wrapper" 
      data-controller="search" 
      data-action="keydown->search#handleKeydown"
      style="position: relative; margin-bottom: 2rem;"
    >
      <form 
        method="get" 
        action="<%= search_path %>" 
        style="display: flex; gap: 0.8rem; margin-bottom: 2rem;" 
        data-search-target="form"
      >
        <input 
          type="text" 
          name="q" 
          value="<%= @query %>" 
          placeholder="Busca transacciones, reportes, proyectos... (Cmd+K)" 
          class="search-input"
          data-search-target="input"
          data-action="input->search#search blur->search#hideResults"
          style="flex: 1; padding: 0.9rem 1rem; border: 4px solid var(--ink); border-radius: 0; font-size: 1rem; background: var(--paper); color: var(--ink);"
          autofocus
        />
        <button type="submit" class="btn-chaos search-submit-btn" style="padding: 0.9rem 2rem;">BUSCAR</button>
      </form>
      
      <div 
        class="search-results-container" 
        data-search-target="results"
        style="
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          margin-top: 0.35rem;
          z-index: 1000;
          max-height: 400px;
          overflow-y: auto;
          background: var(--paper);
          border: 3px solid var(--ink);
          border-radius: 0;
          box-shadow: 6px 6px 0 var(--highlight);
          display: none;
        "
      ></div>
    </div>

    <!-- Advanced Filters (Optional) -->
    <details style="margin-bottom: 2rem; padding: 1rem; background: var(--muted-gray); border-radius: 0; border: 3px solid var(--ink);">
      <summary style="cursor: pointer; font-weight: 900; color: var(--ink); padding: 0.5rem; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.8px;">
        Filtros Avanzados
      </summary>
      
      <form method="get" action="<%= search_path %>" style="margin-top: 1rem;">
        <input type="hidden" name="q" value="<%= @query %>">
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
          <!-- Type Filter -->
          <div>
            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; font-size: 0.9rem;">
              Tipo de contenido
            </label>
            <select name="type" style="width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink);">
              <option value="">Todos los tipos</option>
              <option value="transactions" <%= 'selected' if params[:type] == 'transactions' %>>Transacciones</option>
              <option value="daily_reports" <%= 'selected' if params[:type] == 'daily_reports' %>>Reportes</option>
              <option value="projects" <%= 'selected' if params[:type] == 'projects' %>>Proyectos</option>
              <option value="project_tasks" <%= 'selected' if params[:type] == 'project_tasks' %>>Tareas</option>
              <option value="habits" <%= 'selected' if params[:type] == 'habits' %>>Habitos</option>
              <option value="shopping_items" <%= 'selected' if params[:type] == 'shopping_items' %>>Compras</option>
              <option value="budgets" <%= 'selected' if params[:type] == 'budgets' %>>Presupuestos</option>
              <option value="anonymous_forms" <%= 'selected' if params[:type] == 'anonymous_forms' %>>Formularios</option>
            </select>
          </div>

          <!-- Date Range -->
          <div>
            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; font-size: 0.9rem;">
              Desde
            </label>
            <input 
              type="date" 
              name="from_date" 
              value="<%= params[:from_date] %>"
              style="width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink);"
            />
          </div>

          <div>
            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; font-size: 0.9rem;">
              Hasta
            </label>
            <input 
              type="date" 
              name="to_date" 
              value="<%= params[:to_date] %>"
              style="width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink);"
            />
          </div>
        </div>

        <div style="display: flex; gap: 0.5rem;">
          <button type="submit" class="btn-chaos" style="padding: 0.75rem 1.5rem;">Aplicar Filtros</button>
          <a href="<%= search_path %>" style="padding: 0.75rem 1.5rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); cursor: pointer; text-decoration: none; font-weight: 900; text-transform: uppercase; font-size: 0.8rem;">Limpiar</a>
        </div>
      </form>
    </details>
  </div>
    <% if @query.present? %>
    <% if @total_count > 0 %>
      <div style="margin-bottom: 2rem;">
        <p style="color: #666; font-size: 0.95rem;">
          Se encontraron <strong><%= @total_count %></strong> resultado<%= @total_count == 1 ? '' : 's' %> para "<strong><%= @query %></strong>"
        </p>
      </div>

      <% @results.each do |model_type, records| %>
        <% if records.any? %>
          <section style="margin-bottom: 2.5rem;">
            <h2 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #eee;">
              <%= model_type.to_s.humanize %>
              <span style="font-size: 0.85rem; color: #999; font-weight: 400;">(<%= records.size %>)</span>
            </h2>

            <div style="display: grid; gap: 1rem;">
              <% records.each do |record| %>
                <% case model_type %>
                  <% when :transactions %>
                    <div class="search-result-card">
                      <%= link_to transaction_path(record), style: "text-decoration: none; color: inherit; display: flex; gap: 1rem;" do %>
                        <div style="font-size: 1.5rem;">TX</div>
                        <div style="flex: 1;">
                          <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0;">
                            <%= record.description %>
                          </h3>
                          <p style="font-size: 0.85rem; color: #666; margin: 0.3rem 0 0;">
                            <%= record.transaction_type.humanize %> · L. <%= number_with_precision(record.amount, precision: 2) %> · <%= record.category %>
                          </p>
                        </div>
                      <% end %>
                    </div>
                  <% when :daily_reports %>
                    <div class="search-result-card">
                      <%= link_to daily_report_path(record), style: "text-decoration: none; color: inherit; display: flex; gap: 1rem;" do %>
                        <div style="font-size: 1.5rem;">RP</div>
                        <div style="flex: 1;">
                          <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0;">
                            <%= record.work_title %>
                          </h3>
                          <p style="font-size: 0.85rem; color: #666; margin: 0.3rem 0 0;">
                            Reporte · <%= record.report_date.strftime('%d/%m/%Y') %>
                          </p>
                        </div>
                      <% end %>
                    </div>
                  <% when :projects %>
                    <div class="search-result-card">
                      <%= link_to project_path(record), style: "text-decoration: none; color: inherit; display: flex; gap: 1rem;" do %>
                        <div style="font-size: 1.5rem;">PJ</div>
                        <div style="flex: 1;">
                          <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0;">
                            <%= record.name %>
                          </h3>
                          <p style="font-size: 0.85rem; color: #666; margin: 0.3rem 0 0;">
                            <%= record.description&.truncate(60) || "Proyecto sin descripción" %>
                          </p>
                        </div>
                      <% end %>
                    </div>
                  <% when :project_tasks %>
                    <div class="search-result-card">
                      <%= link_to project_project_task_path(record.project, record), style: "text-decoration: none; color: inherit; display: flex; gap: 1rem;" do %>
                        <div style="font-size: 1.5rem;"><%= record.completed? ? 'OK' : '--' %></div>
                        <div style="flex: 1;">
                          <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0;">
                            <%= record.name %>
                          </h3>
                          <p style="font-size: 0.85rem; color: #666; margin: 0.3rem 0 0;">
                            Tarea · <%= record.project.name %>
                          </p>
                        </div>
                      <% end %>
                    </div>
                  <% when :habits %>
                    <div class="search-result-card">
                      <%= link_to habit_path(record), style: "text-decoration: none; color: inherit; display: flex; gap: 1rem;" do %>
                        <div style="font-size: 1.5rem;">HB</div>
                        <div style="flex: 1;">
                          <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0;">
                            <%= record.name %>
                          </h3>
                          <p style="font-size: 0.85rem; color: #666; margin: 0.3rem 0 0;">
                            Hábito
                          </p>
                        </div>
                      <% end %>
                    </div>
                  <% when :shopping_items %>
                    <div class="search-result-card">
                      <%= link_to shopping_item_path(record), style: "text-decoration: none; color: inherit; display: flex; gap: 1rem;" do %>
                        <div style="font-size: 1.5rem;">CP</div>
                        <div style="flex: 1;">
                          <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0;">
                            <%= record.name %>
                          </h3>
                          <p style="font-size: 0.85rem; color: #666; margin: 0.3rem 0 0;">
                            Compra · Cantidad: <%= record.quantity %>
                          </p>
                        </div>
                      <% end %>
                    </div>
                  <% when :budgets %>
                    <div class="search-result-card">
                      <%= link_to budget_path(record), style: "text-decoration: none; color: inherit; display: flex; gap: 1rem;" do %>
                        <div style="font-size: 1.5rem;">BG</div>
                        <div style="flex: 1;">
                          <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0;">
                            <%= record.category %>
                          </h3>
                          <p style="font-size: 0.85rem; color: #666; margin: 0.3rem 0 0;">
                            Presupuesto · L. <%= number_with_precision(record.monthly_limit, precision: 2) %>
                          </p>
                        </div>
                      <% end %>
                    </div>
                  <% when :anonymous_forms %>
                    <div class="search-result-card">
                      <%= link_to anonymous_form_path(record), style: "text-decoration: none; color: inherit; display: flex; gap: 1rem;" do %>
                        <div style="font-size: 1.5rem;">FM</div>
                        <div style="flex: 1;">
                          <h3 style="font-size: 0.95rem; font-weight: 600; margin: 0;">
                            <%= record.title %>
                          </h3>
                          <p style="font-size: 0.85rem; color: #666; margin: 0.3rem 0 0;">
                            Formulario · <%= record.description&.truncate(50) || "Sin descripción" %>
                          </p>
                        </div>
                      <% end %>
                    </div>
                <% end %>
              <% end %>
            </div>
          </section>
        <% end %>
      <% end %>
    <% else %>
      <div style="text-align: center; padding: 3rem 1rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">BUSCAR</div>
        <p style="font-size: 1.1rem; color: #666;">No se encontraron resultados para "<strong><%= @query %></strong>"</p>
        <p style="color: #999; margin-top: 0.5rem;">Intenta con otros términos de búsqueda</p>
      </div>
    <% end %>
  <% else %>
    <div style="text-align: center; padding: 3rem 1rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">BUSQUEDA</div>
      <p style="font-size: 1.1rem; color: #666;">Busca en toda tu información</p>
      <p style="color: #999; margin-top: 0.5rem;">Transacciones, reportes, proyectos, hábitos y más</p>
    </div>
  <% end %>
</div>

<style>
  .search-input {
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--ink) !important;
    box-shadow: 6px 6px 0 var(--highlight);
  }

  .search-result-card {
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 0;
    padding: 1rem;
    transition: all 0.2s ease;
  }

  .search-result-card:hover {
    box-shadow: 4px 4px 0 var(--highlight);
    background-color: var(--muted-gray);
  }

  .search-result-card a {
    display: block;
  }

  /* Dropdown autocomplete styles */
  .search-dropdown {
    padding: 0.5rem 0;
  }

  .search-group {
    padding: 0.5rem 0;
  }

  .search-group-title {
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: #999;
    margin: 0;
    margin-top: 0.5rem;
  }

  .search-group:first-child .search-group-title {
    margin-top: 0;
  }

  .search-result-item {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 1rem;
    color: inherit;
    text-decoration: none;
    transition: all 0.15s ease;
    border-left: 3px solid transparent;
  }

  .search-result-item:hover,
  .search-history-item:hover {
    background-color: #f5f5f5;
    border-left-color: #007bff;
  }

  .search-result-item.is-selected,
  .search-history-item.is-selected {
    background-color: #e8f4ff;
    border-left-color: #007bff;
  }

  .search-history-item {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 1rem;
    color: inherit;
    text-decoration: none;
    transition: all 0.15s ease;
    border-left: 3px solid transparent;
  }

  .search-result-icon {
    font-size: 1.25rem;
    min-width: 1.5rem;
    text-align: center;
  }

  .search-result-content {
    flex: 1;
    min-width: 0;
  }

  .search-result-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: #222;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
  }

  .search-result-subtitle {
    font-size: 0.8rem;
    color: #999;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0.25rem 0 0;
  }

  .search-no-results {
    padding: 1.5rem;
    text-align: center;
    color: #999;
    font-size: 0.9rem;
  }

  .search-wrapper {
    position: relative;
  }

  [data-theme="brat"] .search-submit-btn.btn-chaos,
  [data-theme="brat"] .search-submit-btn.btn-chaos:hover,
  [data-theme="brat"] .search-submit-btn.btn-chaos:active {
    background: #6a9622 !important;
    color: #111 !important;
    box-shadow: 6px 6px 0 #2f4d10 !important;
  }

  [data-theme="brat"] .search-results-container,
  [data-theme="brat"] .search-result-card,
  [data-theme="brat"] details {
    background: #a4e82d !important;
    border-color: #1b2a0f !important;
  }

  [data-theme="brat"] .search-result-item:hover,
  [data-theme="brat"] .search-history-item:hover,
  [data-theme="brat"] .search-result-item.is-selected,
  [data-theme="brat"] .search-history-item.is-selected {
    background: #b9f24a !important;
    border-left-color: #1b2a0f !important;
  }

  @media (max-width: 640px) {
    .search-results-container {
      max-height: 300px !important;
    }
    
    .search-result-item {
      padding: 0.5rem 0.75rem;
    }

    .search-group-title {
      padding: 0.4rem 0.75rem;
      font-size: 0.7rem;
    }
  }
</style>
