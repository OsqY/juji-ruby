<%= turbo_frame_tag "projects_content" do %>
  <%= render "shared/frame_flash" %>

  <div class="aws-content">
    <%= render "layouts/aws_page_header", title: "METAS Y PROYECTOS",
      subtitle: "Transformando ideas en realidades",
      breadcrumbs: [["Home", root_path], ["Proyectos", projects_path]] %>

    <div class="aws-page-header-actions aws-mb-2">
      <%= render "shared/export_actions", model: "projects" %>
    </div>

    <div class="aws-card aws-mb-2">
      <div class="aws-card-header">
        <h3 class="aws-card-title">Iniciar nuevo proyecto</h3>
      </div>
      <%= form_with(model: @new_project) do |f| %>
        <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 12px; flex-wrap: wrap;">
          <div class="field">
            <%= f.label :name, "Nombre del proyecto" %>
            <%= f.text_field :name, placeholder: "Ej. Lanzar mi App, Remodelar sala...", required: true %>
          </div>
          <div class="field">
            <%= f.label :target_date, "Fecha objetivo" %>
            <%= f.date_field :target_date %>
          </div>
          <div style="display: flex; align-items: flex-end;">
            <%= f.submit "Crear", class: "aws-btn aws-btn-primary" %>
          </div>
          <div class="field" style="grid-column: 1 / -1;">
            <%= f.label :description, "Descripción (opcional)" %>
            <%= f.text_area :description, placeholder: "Breve resumen del objetivo...", rows: 2 %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @projects.any? %>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px;">
        <% @projects.each do |project| %>
          <div class="aws-card">
            <div class="aws-card-header">
              <h3 class="aws-card-title"><%= project.name %></h3>
            </div>
            <div style="padding: 16px; display: flex; flex-direction: column; gap: 12px;">
              <% if project.target_date.present? %>
                <div style="font-size: 12px; color: var(--aws-text-secondary);">Meta: <%= project.target_date.strftime("%d %b %Y").upcase %></div>
              <% end %>
              <% if project.description.present? %>
                <p style="font-size: 14px; color: var(--aws-text-secondary); margin: 0;"><%= project.description %></p>
              <% end %>

              <% total_tasks = project.project_tasks.count %>
              <% completed_tasks = project.project_tasks.where(completed: true).count %>
              <% percent = total_tasks > 0 ? (completed_tasks.to_f / total_tasks * 100).round : 0 %>

              <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 4px;">
                  <span style="font-size: 24px; font-weight: 700;"><%= percent %>%</span>
                  <span style="font-size: 11px; color: var(--aws-text-secondary);"><%= completed_tasks %> / <%= total_tasks %> tareas</span>
                </div>
                <div style="background: var(--aws-border); height: 8px; overflow: hidden; border-radius: 4px;">
                  <div style="background: var(--aws-primary); height: 100%; width: <%= percent %>%; transition: width 0.3s; border-radius: 4px;"></div>
                </div>
              </div>

              <div style="display: flex; flex-direction: column; gap: 8px;">
                <% project.project_tasks.select(&:persisted?).each do |task| %>
                  <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <%= button_to toggle_project_project_task_path(project, task), method: :post, style: "border: none; background: none; padding: 0; cursor: pointer;" do %>
                        <div style="width: 16px; height: 16px; border: 2px solid var(--aws-border); border-radius: 2px; <%= task.completed ? 'background: var(--aws-primary);' : 'background: var(--aws-bg-primary);' %> display: flex; align-items: center; justify-content: center;">
                          <% if task.completed %>
                            <i data-lucide="check" style="width: 10px; height: 10px; color: white; stroke-width: 4;"></i>
                          <% end %>
                        </div>
                      <% end %>
                      <span style="font-size: 13px; font-weight: 600; <%= 'text-decoration: line-through; color: var(--aws-text-secondary);' if task.completed %>"><%= task.name %></span>
                    </div>
                    <%= button_to project_project_task_path(project, task), method: :delete, class: "aws-btn aws-btn-danger", style: "padding: 2px 8px; font-size: 11px;" do %>
                      <i data-lucide="trash-2" style="width: 12px; height: 12px;"></i>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <%= form_with(model: [project, project.project_tasks.build]) do |f| %>
                <div style="display: flex; gap: 8px;">
                  <%= f.text_field :name, placeholder: "+ Agregar tarea...", style: "flex: 1; font-size: 13px; padding: 6px 8px; border: 1px solid var(--aws-border); border-radius: 2px;" %>
                  <%= f.submit "OK", class: "aws-btn aws-btn-primary", style: "padding: 4px 12px; font-size: 12px;" %>
                </div>
              <% end %>
            </div>
            <div style="padding: 12px 16px; border-top: 1px solid var(--aws-border); text-align: right;">
              <%= button_to project_path(project), method: :delete, class: "aws-btn aws-btn-danger", style: "padding: 2px 8px; font-size: 12px;", data: { turbo_confirm: "¿Eliminar proyecto?" } do %>
                <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="aws-empty-state">
        <p class="aws-empty-state-desc">No hay proyectos activos / No projects yet</p>
      </div>
    <% end %>
  </div>

  <div class="legacy-content">
    <div class="chaotic-container">
      <div style="border-bottom: 8px solid var(--ink); margin-bottom: 4rem; padding-bottom: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
          <div>
            <h1 class="form-title">METAS Y PROYECTOS</h1>
            <p style="font-weight: 700; opacity: 0.6;">TRANSFORMANDO IDEAS EN REALIDADES / MAKING IT HAPPEN</p>
          </div>
          <%= render "shared/export_actions", model: "projects" %>
        </div>
      </div>

      <div class="report-section-block" style="margin-bottom: 4rem;">
        <h2 class="section-title">INICIAR NUEVO PROYECTO</h2>
        <%= form_with(model: @new_project) do |f| %>
          <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 1.5rem; flex-wrap: wrap;">
            <div class="field">
              <%= f.label :name, "NOMBRE DEL PROYECTO" %>
              <%= f.text_field :name, placeholder: "Ej. Lanzar mi App, Remodelar sala...", required: true %>
            </div>
            <div class="field">
              <%= f.label :target_date, "FECHA OBJETIVO" %>
              <%= f.date_field :target_date %>
            </div>
            <div style="display: flex; align-items: flex-end;">
              <%= f.submit "CREAR +", class: "btn-chaos", style: "padding: 1rem 2rem;" %>
            </div>
            <div class="field" style="grid-column: 1 / -1;">
              <%= f.label :description, "DESCRIPCIÓN (OPCIONAL)" %>
              <%= f.text_area :description, placeholder: "Breve resumen del objetivo...", rows: 2 %>
            </div>
          </div>
        <% end %>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 2.5rem;">
        <% if @projects.any? %>
          <% @projects.each do |project| %>
            <div class="report-section-block" style="padding: 2rem; position: relative; display: flex; flex-direction: column; gap: 1.5rem;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                  <h2 style="margin: 0; font-size: 1.8rem; line-height: 1.1; text-transform: uppercase;"><%= project.name %></h2>
                  <% if project.target_date.present? %>
                    <p style="font-size: 0.7rem; font-weight: 900; margin: 0.5rem 0; opacity: 0.5;">META: <%= project.target_date.strftime("%d %b %Y").upcase %></p>
                  <% end %>
                  <% if project.description.present? %>
                    <p class="report-text" style="font-size: 0.9rem; margin: 0.6rem 0 0; opacity: 0.8;"><%= project.description %></p>
                  <% end %>
                </div>
                <%= button_to project_path(project), method: :delete, class: "aws-btn aws-btn-danger", data: { turbo_confirm: "¿Eliminar proyecto?" } do %>
                  <i data-lucide="trash-2" style="width: 20px; height: 20px;"></i>
                <% end %>
              </div>

              <% total_tasks = project.project_tasks.count %>
              <% completed_tasks = project.project_tasks.where(completed: true).count %>
              <% percent = total_tasks > 0 ? (completed_tasks.to_f / total_tasks * 100).round : 0 %>

              <div style="margin-top: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 0.5rem;">
                  <span style="font-size: 3.5rem; font-weight: 900; line-height: 1;"><%= percent %>%</span>
                  <span style="font-size: 0.7rem; font-weight: 900; opacity: 0.4;"><%= completed_tasks %> / <%= total_tasks %> TAREAS</span>
                </div>
                <div style="width: 100%; height: 20px; background: var(--muted-gray); border: 4px solid var(--ink); overflow: hidden;">
                  <div style="width: <%= percent %>%; height: 100%; background: var(--highlight); transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);"></div>
                </div>
              </div>

              <div style="margin-top: 1rem;">
                <h4 style="font-size: 0.7rem; font-weight: 900; margin-bottom: 1rem; border-bottom: 2px solid var(--ink); padding-bottom: 0.2rem;">LOGROS / MILESTONES</h4>
                <div style="display: flex; flex-direction: column; gap: 0.8rem;">
                  <% project.project_tasks.select(&:persisted?).each do |task| %>
                    <div style="display: flex; align-items: center; justify-content: space-between; <%= 'opacity: 0.5;' if task.completed %>">
                      <div style="display: flex; align-items: center; gap: 0.8rem;">
                        <%= button_to toggle_project_project_task_path(project, task), method: :post, style: "border: none; background: none; padding: 0; cursor: pointer;" do %>
                          <div style="width: 20px; height: 20px; border: 3px solid var(--ink); border-radius: 2px; <%= task.completed ? 'background: var(--ink);' : 'background: var(--paper);' %> display: flex; align-items: center; justify-content: center;">
                            <% if task.completed %>
                              <i data-lucide="check" style="width: 12px; height: 12px; color: var(--paper); stroke-width: 4;"></i>
                            <% end %>
                          </div>
                        <% end %>
                        <span style="font-weight: 700; font-size: 0.9rem; <%= 'text-decoration: line-through;' if task.completed %>"><%= task.name.upcase %></span>
                      </div>
                      <%= button_to project_project_task_path(project, task), method: :delete, class: "aws-btn aws-btn-danger" do %>
                        <i data-lucide="trash-2" style="width: 12px; height: 12px;"></i>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div style="margin-top: auto; padding-top: 1rem; border-top: 2px solid var(--muted-gray);">
                <%= form_with(model: [project, project.project_tasks.build]) do |f| %>
                  <div style="display: flex; gap: 0.5rem;">
                    <%= f.text_field :name, placeholder: "+ Agregar tarea...", style: "flex: 1; font-size: 0.8rem; padding: 0.5rem;" %>
                    <%= f.submit "OK", class: "btn-chaos", style: "padding: 0.5rem 1rem; font-size: 0.7rem;" %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="aws-empty-state" style="grid-column: 1 / -1;">
            <p class="aws-empty-state-desc">NO HAY PROYECTOS ACTIVOS / NO PROJECTS YET</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
