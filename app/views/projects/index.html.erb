<div class="chaotic-container">
  <div style="border-bottom: 8px solid var(--ink); margin-bottom: 4rem; padding-bottom: 1rem;">
    <h1 class="form-title">METAS Y PROYECTOS</h1>
    <p style="font-weight: 700; opacity: 0.6;">TRANSFORMANDO IDEAS EN REALIDADES / MAKING IT HAPPEN</p>
  </div>

  <%# Form to Add New Project %>
  <div class="report-section-block" style="margin-bottom: 4rem;">
    <h2 class="section-title">INICIAR NUEVO PROYECTO</h2>
    <%= form_with(model: @new_project) do |f| %>
      <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 1.5rem; flex-wrap: wrap;">
        <div>
          <%= f.label :name, "NOMBRE DEL PROYECTO", style: "font-size: 0.7rem; font-weight: 900; opacity: 0.5; display: block;" %>
          <%= f.text_field :name, placeholder: "Ej. Lanzar mi App, Remodelar sala...", required: true %>
        </div>
        <div>
          <%= f.label :target_date, "FECHA OBJETIVO", style: "font-size: 0.7rem; font-weight: 900; opacity: 0.5; display: block;" %>
          <%= f.date_field :target_date %>
        </div>
        <div style="display: flex; align-items: flex-end;">
          <%= f.submit "CREAR +", class: "btn-chaos", style: "padding: 1rem 2rem;" %>
        </div>
        <div style="grid-column: 1 / -1;">
          <%= f.label :description, "DESCRIPCIÓN (OPCIONAL)", style: "font-size: 0.7rem; font-weight: 900; opacity: 0.5; display: block;" %>
          <%= f.text_area :description, placeholder: "Breve resumen del objetivo...", rows: 2, style: "width: 100%;" %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Project Grid %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 2.5rem;">
    <% if @projects.any? %>
      <% @projects.each do |project| %>
        <div class="report-section-block" style="padding: 2rem; position: relative; display: flex; flex-direction: column; gap: 1.5rem;">
          <%# Project Header %>
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <h2 style="margin: 0; font-size: 1.8rem; line-height: 1.1; text-transform: uppercase;"><%= project.name %></h2>
              <% if project.target_date.present? %>
                <p style="font-size: 0.7rem; font-weight: 900; margin: 0.5rem 0; opacity: 0.5;">META: <%= project.target_date.strftime("%d %b %Y").upcase %></p>
              <% end %>
            </div>
            <%= button_to project_path(project), method: :delete, class: "delete-btn-link", data: { confirm: "¿Eliminar proyecto?" } do %>
               <i data-lucide="trash-2" style="width: 20px; height: 20px;"></i>
            <% end %>
          </div>

          <%# Progress Visualization %>
          <% total_tasks = project.project_tasks.count %>
          <% completed_tasks = project.project_tasks.where(completed: true).count %>
          <% percent = total_tasks > 0 ? (completed_tasks.to_f / total_tasks * 100).round : 0 %>
          
          <div style="margin-top: 1rem;">
             <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 0.5rem;">
                <span style="font-size: 3.5rem; font-weight: 900; line-height: 1;"><%= percent %>%</span>
                <span style="font-size: 0.7rem; font-weight: 900; opacity: 0.4;"><%= completed_tasks %> / <%= total_tasks %> TAREAS</span>
             </div>
             <div style="width: 100%; height: 20px; background: var(--muted-gray); border: 4px solid var(--ink); overflow: hidden;">
                <div style="width: <%= percent %>%; height: 100%; background: var(--highlight); transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);"></div>
             </div>
          </div>

          <%# Task List %>
          <div style="margin-top: 1rem;">
             <h4 style="font-size: 0.7rem; font-weight: 900; margin-bottom: 1rem; border-bottom: 2px solid var(--ink); padding-bottom: 0.2rem;">LOGROS / MILESTONES</h4>
             <div style="display: flex; flex-direction: column; gap: 0.8rem;">
                <% project.project_tasks.each do |task| %>
                  <div style="display: flex; align-items: center; justify-content: space-between; <%= 'opacity: 0.5;' if task.completed %>">
                    <div style="display: flex; align-items: center; gap: 0.8rem;">
                      <%= button_to toggle_project_project_task_path(project, task), method: :post, style: "border: none; background: none; padding: 0; cursor: pointer;" do %>
                        <div style="width: 20px; height: 20px; border: 3px solid var(--ink); border-radius: 2px; <%= task.completed ? 'background: var(--ink);' : 'background: var(--paper);' %> display: flex; align-items: center; justify-content: center;">
                           <% if task.completed %>
                             <i data-lucide="check" style="width: 12px; height: 12px; color: var(--paper); stroke-width: 4;"></i>
                           <% end %>
                        </div>
                      <% end %>
                      <span style="font-weight: 700; font-size: 0.9rem; <%= 'text-decoration: line-through;' if task.completed %>"><%= task.name.upcase %></span>
                    </div>
                    <%= button_to project_project_task_path(project, task), method: :delete, class: "delete-btn-link", style: "font-size: 0.6rem; opacity: 0.3;" do %>
                      <i data-lucide="trash-2" style="width: 12px; height: 12px;"></i>
                    <% end %>
                  </div>
                <% end %>
             </div>
          </div>

          <%# Add Task Form %>
          <div style="margin-top: auto; padding-top: 1rem; border-top: 2px solid var(--muted-gray);">
             <%= form_with(model: [project, project.project_tasks.build]) do |f| %>
                <div style="display: flex; gap: 0.5rem;">
                   <%= f.text_field :name, placeholder: "+ Agregar tarea...", style: "flex: 1; font-size: 0.8rem; padding: 0.5rem;" %>
                   <%= f.submit "OK", class: "btn-chaos", style: "padding: 0.5rem 1rem; font-size: 0.7rem;" %>
                </div>
             <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="report-section-block" style="grid-column: 1 / -1; text-align: center; padding: 4rem;">
        <p style="font-weight: 900; opacity: 0.3; font-size: 1.2rem;">NO HAY PROYECTOS ACTIVOS / NO PROJECTS YET</p>
      </div>
    <% end %>
  </div>
</div>
