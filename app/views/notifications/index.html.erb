<div class="dashboard-container">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <h1>Notificaciones</h1>
    <% if @unread_count > 0 %>
      <%= button_to "Marcar todas como leídas", mark_all_as_read_notifications_path, 
          method: :patch, 
          class: "button-secondary",
          style: "padding: 0.5rem 1rem; font-size: 0.9rem;" %>
    <% end %>
  </div>

  <% if @notifications.empty? %>
    <div style="text-align: center; padding: 2rem; color: #666;">
      <p>No tienes notificaciones</p>
    </div>
  <% else %>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <% @notifications.each do |notification| %>
        <div style="
          background: <%= notification.unread? ? '#F0F7FF' : '#F8F8F8' %>;
          border-left: 4px solid <%= notification_color(notification) %>;
          padding: 1rem;
          border-radius: 4px;
          display: flex;
          justify-content: space-between;
          align-items: flex-start;
        ">
          <div style="flex: 1;">
            <p style="margin: 0; font-weight: 600; color: #333;">
              <%= notification_title(notification) %>
            </p>
            <p style="margin: 0.5rem 0 0; color: #666;">
              <%= notification.message %>
            </p>
            <p style="margin: 0.5rem 0 0; font-size: 0.85rem; color: #999;">
              <%= time_ago_in_words(notification.created_at) %> ago
            </p>
          </div>
          <% if notification.unread? %>
            <%= button_to "OK", mark_as_read_notification_path(notification), 
                method: :patch,
                class: "button-small",
                style: "background: #2D5A27; color: white; border: none; padding: 0.5rem 1rem; cursor: pointer; margin-left: 1rem;" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<style>
  .button-secondary {
    background: #f0f0f0;
    color: #333;
    border: 1px solid #ddd;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
  }

  .button-secondary:hover {
    background: #e0e0e0;
  }

  .button-small {
    background: #2D5A27;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
  }

  .button-small:hover {
    background: #1f4119;
  }
</style>
