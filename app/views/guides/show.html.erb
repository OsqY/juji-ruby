        <li><%= t("guide.productivity.step_1") %></li>
        <li><%= t("guide.productivity.step_2") %></li>
        <li><%= t("guide.productivity.step_3") %></li>
      </ol>
      <div class="guide-actions">
        <%= link_to t("guide.quick_actions.open_projects"), projects_path, class: "btn-chaos", style: "font-size: 0.85rem; padding: 0.7rem 1rem;" %>
