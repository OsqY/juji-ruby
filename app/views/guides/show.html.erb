<div class="chaotic-container guide-page">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <h1 style="font-size: 3rem;"><%= t("guide.title") %></h1>
    <%= link_to t("guide.quick_actions.go_dashboard"), dashboard_path, class: "nav-link" %>
  </div>

  <section class="report-section-block" style="margin-bottom: 1.5rem;">
    <span class="section-label"><%= t("guide.labels.what_is_new") %></span>
    <h2 class="section-title" style="margin-top: 0.8rem;"><%= t("guide.whats_new.title") %></h2>
    <p class="report-text" style="font-size: 1rem; margin-top: 0.8rem;"><%= t("guide.whats_new.whiteboard") %></p>
    <p class="report-text" style="font-size: 1rem;"><%= t("guide.whats_new.forms") %></p>
    <p class="report-text" style="font-size: 1rem;"><%= t("guide.whats_new.search") %></p>
  </section>

  <div class="guide-grid">
    <section class="guide-card report-section-block">
      <span class="section-label" style="background: #1f8f5f; color: white;"><%= t("guide.labels.reports") %></span>
      <h3 class="section-title"><%= t("guide.reports.title") %></h3>
      <ol class="guide-steps">
        <li><%= t("guide.reports.step_1") %></li>
        <li><%= t("guide.reports.step_2") %></li>
        <li><%= t("guide.reports.step_3") %></li>
      </ol>
      <div class="guide-actions">
        <%= link_to t("guide.quick_actions.open_reports"), daily_reports_path, class: "btn-chaos", style: "font-size: 0.85rem; padding: 0.7rem 1rem;" %>
      </div>
    </section>

    <section class="guide-card report-section-block">
      <span class="section-label" style="background: var(--accent-blue); color: white;"><%= t("guide.labels.finance") %></span>
      <h3 class="section-title"><%= t("guide.finance.title") %></h3>
      <ol class="guide-steps">
        <li><%= t("guide.finance.step_1") %></li>
        <li><%= t("guide.finance.step_2") %></li>
        <li><%= t("guide.finance.step_3") %></li>
      </ol>
      <div class="guide-actions">
        <%= link_to t("guide.quick_actions.open_finance"), transactions_path, class: "btn-chaos", style: "font-size: 0.85rem; padding: 0.7rem 1rem;" %>
      </div>
    </section>

    <section class="guide-card report-section-block">
      <span class="section-label"><%= t("guide.labels.productivity") %></span>
      <h3 class="section-title"><%= t("guide.productivity.title") %></h3>
      <ol class="guide-steps">
        <li><%= t("guide.productivity.step_1") %></li>
        <li><%= t("guide.productivity.step_2") %></li>
        <li><%= t("guide.productivity.step_3") %></li>
      </ol>
      <div class="guide-actions">
        <%= link_to t("guide.quick_actions.open_projects"), projects_path, class: "btn-chaos", style: "font-size: 0.85rem; padding: 0.7rem 1rem;" %>
      </div>
    </section>

    <section class="guide-card report-section-block">
      <span class="section-label" style="background: #8B5CF6; color: white;"><%= t("guide.labels.whiteboards") %></span>
      <h3 class="section-title"><%= t("guide.whiteboards.title") %></h3>
      <ol class="guide-steps">
        <li><%= t("guide.whiteboards.step_1") %></li>
        <li><%= t("guide.whiteboards.step_2") %></li>
        <li><%= t("guide.whiteboards.step_3") %></li>
      </ol>
      <div class="guide-actions">
        <%= link_to t("guide.quick_actions.open_whiteboards"), whiteboards_path, class: "btn-chaos", style: "font-size: 0.85rem; padding: 0.7rem 1rem;" %>
      </div>
    </section>

    <section class="guide-card report-section-block">
      <span class="section-label" style="background: #F59E0B; color: white;"><%= t("guide.labels.forms") %></span>
      <h3 class="section-title"><%= t("guide.forms.title") %></h3>
      <ol class="guide-steps">
        <li><%= t("guide.forms.step_1") %></li>
        <li><%= t("guide.forms.step_2") %></li>
        <li><%= t("guide.forms.step_3") %></li>
      </ol>
      <div class="guide-actions">
        <%= link_to t("guide.quick_actions.open_forms"), anonymous_forms_path, class: "btn-chaos", style: "font-size: 0.85rem; padding: 0.7rem 1rem;" %>
      </div>
    </section>

    <section class="guide-card report-section-block">
      <span class="section-label" style="background: #ddd; color: #111;"><%= t("guide.labels.tips") %></span>
      <h3 class="section-title"><%= t("guide.tips.title") %></h3>
      <ul class="guide-tips-list">
        <li><%= t("guide.tips.item_1") %></li>
        <li><%= t("guide.tips.item_2") %></li>
        <li><%= t("guide.tips.item_3") %></li>
      </ul>
    </section>
  </div>
</div>
