    </section>

    <section class="guide-card report-section-block">
      <span class="section-label" style="background: #8B5CF6; color: white;"><%= t("guide.labels.whiteboards") %></span>
      <h3 class="section-title"><%= t("guide.whiteboards.title") %></h3>
      <ol class="guide-steps">
        <li><%= t("guide.whiteboards.step_1") %></li>
        <li><%= t("guide.whiteboards.step_2") %></li>
        <li><%= t("guide.whiteboards.step_3") %></li>
      </ol>
      <div class="guide-actions">
        <%= link_to t("guide.quick_actions.open_whiteboards"), whiteboards_path, class: "btn-chaos", style: "font-size: 0.85rem; padding: 0.7rem 1rem;" %>
      </div>
    </section>

    <section class="guide-card report-section-block">
      <span class="section-label" style="background: #F59E0B; color: white;"><%= t("guide.labels.forms") %></span>
      <h3 class="section-title"><%= t("guide.forms.title") %></h3>
      <ol class="guide-steps">
        <li><%= t("guide.forms.step_1") %></li>
        <li><%= t("guide.forms.step_2") %></li>
        <li><%= t("guide.forms.step_3") %></li>
      </ol>
      <div class="guide-actions">
        <%= link_to t("guide.quick_actions.open_forms"), anonymous_forms_path, class: "btn-chaos", style: "font-size: 0.85rem; padding: 0.7rem 1rem;" %>
      </div>
    </section>

    <section class="guide-card report-section-block">
      <span class="section-label" style="background: #ddd; color: #111;"><%= t("guide.labels.tips") %></span>
      <h3 class="section-title"><%= t("guide.tips.title") %></h3>
      <ul class="guide-tips-list">
        <li><%= t("guide.tips.item_1") %></li>
        <li><%= t("guide.tips.item_2") %></li>
        <li><%= t("guide.tips.item_3") %></li>
      </ul>
    </section>
  </div>
</div>
</div>
