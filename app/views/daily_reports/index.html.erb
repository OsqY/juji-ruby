<div class="chaotic-container">
  <%# Daily Habit Summary for Today %>
  <% habits = current_user.habits %>
  <% if habits.any? %>
    <% today_logs = habits.joins(:habit_logs).where(habit_logs: { log_date: Date.today, completed: true }).count %>
    <div class="report-section-block" style="margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; padding: 1rem 2rem; border-left: 1rem solid var(--highlight);">
      <div>
        <h2 style="margin: 0; font-size: 0.8rem; font-weight: 900; opacity: 0.5;">HÁBITOS HOY / HABITS TODAY</h2>
        <div style="font-size: 1.5rem; font-weight: 900;">
          <%= today_logs %> DE <%= habits.count %> COMPLETADOS
        </div>
      </div>
      <%= link_to "+", habits_path, class: "btn-chaos", style: "width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; padding: 0;" %>
    </div>
  <% end %>

  <div class="index-header">
    <h1 class="chaotic-title">ARCHIVO<br>JUJI</h1>
    <%= link_to "NUEVO REPORTE +", new_daily_report_path, class: "btn-chaos" %>
  </div>

  <% @daily_reports.each do |report| %>
    <section class="report-card" data-controller="export" data-export-target="card">
      <div class="daily-header">
        <div class="daily-date">
          <%= report.report_date.strftime("%d/%m") %>
        </div>
        <div class="daily-metadata">
          ENTRADA NO. <%= report.id %><br>
          <%= t("date.day_names")[report.report_date.wday].upcase %><br>
          <%= report.report_date.strftime("%Y") %>
        </div>
      </div>

      <% if report.photo.attached? %>
        <div class="report-photo-main" style="margin: 2rem 0; border: 8px solid var(--ink); box-shadow: 10px 10px 0 var(--ink);">
          <%= image_tag report.photo, style: "width: 100%; display: block; filter: grayscale(20%);" %>
        </div>
      <% end %>

      <div class="report-grid">
        <div class="report-column">
          <span class="section-label">PASADO</span>
          <h2 class="section-title">¿Qué hice ayer?</h2>
          <div class="report-text"><%= format_as_list report.yesterday %></div>
        </div>

        <div class="report-column">
          <span class="section-label" style="background: var(--accent-blue); color: white;">PRESENTE</span>
          <h2 class="section-title">¿Qué voy a hacer hoy?</h2>
          <div class="report-text"><%= format_as_list report.today %></div>
        </div>

        <% if report.blockers.present? %>
          <div class="report-section-full">
            <div class="report-section-block">
              <span class="section-label" style="background: var(--ink); color: var(--paper);">IMPEDIMENTOS</span>
              <div class="report-text" style="font-weight: 700;"><%= report.blockers %></div>
            </div>
          </div>
        <% end %>

        <% if report.additional_details.present? %>
          <div class="report-section-full" style="margin-top: 1rem;">
            <div class="report-section-block" style="background: transparent; border: 2px dashed #ddd;">
              <span class="section-label" style="background: #ddd; color: #000;">EXTRAS</span>
              <div class="report-text" style="font-size: 1rem;"><%= report.additional_details %></div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="report-actions">
        <div>
          <button data-action="click->export#download" class="delete-btn-link" style="color: var(--accent-blue); opacity: 0.8 !important;">EXPORTAR IMAGEN</button>
        </div>
        <div class="action-links">
          <%= link_to "EDITAR", edit_daily_report_path(report), style: "color: var(--ink); text-decoration: none;" %>
          <span style="opacity: 0.3;">/</span>
          <%= button_to "ELIMINAR", daily_report_path(report), 
              method: :delete, 
              data: { turbo_confirm: "¿Estás seguro de que deseas eliminar este reporte?" }, 
              class: "delete-btn-link" %>
        </div>
      </div>
    </section>
  <% end %>
</div>
