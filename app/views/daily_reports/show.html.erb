<%= render "layouts/aws_page_header", title: "DETALLE REPORTE",
  breadcrumbs: [["Home", root_path], ["Reportes", daily_reports_path(view: "week")], ["Detalle", nil]] %>

<div class="chaotic-container">
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
    <h1 style="font-size: 2.8rem;">DETALLE<br>REPORTE</h1>
    <%= link_to "VOLVER A REPORTES", daily_reports_path(view: "week", date: @daily_report.report_date.strftime("%Y-%m-%d")), class: "nav-link" %>
  </div>

  <section class="report-section-block" style="margin-bottom: 1.2rem;">
    <span class="section-label" style="background: #1f8f5f; color: white;">EN CURSO</span>
    <h2 class="section-title" style="margin-top: 0.8rem;"><%= @daily_report.work_title.presence || "SIN TITULO" %></h2>
    <p style="font-size: 0.86rem; font-weight: 800; opacity: 0.8; margin-top: 0.45rem;">
      RESPONSABLE: <%= @daily_report.worked_by.presence || "SIN RESPONSABLE" %> | FECHA: <%= @daily_report.report_date.strftime("%d/%m/%Y") %>
    </p>
  </section>

  <div class="report-grid">
    <div class="report-column">
      <section class="report-section-block">
        <span class="section-label">HE HECHO</span>
        <h2 class="section-title">Que he hecho</h2>
        <div class="report-text"><%= format_as_list(@daily_report.yesterday) %></div>
      </section>
    </div>

    <div class="report-column">
      <section class="report-section-block">
        <span class="section-label">HARE</span>
        <h2 class="section-title">Que hare</h2>
        <div class="report-text"><%= format_as_list(@daily_report.today) %></div>
      </section>
    </div>
  </div>

  <% if @daily_report.blockers.present? %>
    <section class="report-section-block" style="margin-top: 1.2rem;">
      <span class="section-label" style="background: var(--ink); color: var(--paper);">IMPEDIMENTOS</span>
      <div class="report-text <%= 'blocker-text-resolved' if @daily_report.blockers_resolved %>" style="margin-top: 0.7rem; font-weight: 700;">
        <%= @daily_report.blockers %>
      </div>
    </section>
  <% end %>

  <% if @daily_report.additional_details.present? %>
    <section class="report-section-block" style="margin-top: 1.2rem;">
      <span class="section-label" style="background: #ddd; color: #111;">NOTAS</span>
      <div class="report-text" style="margin-top: 0.7rem; font-size: 1rem;"><%= @daily_report.additional_details %></div>
    </section>
  <% end %>

  <section class="report-section-block" style="margin-top: 1.2rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
    <%= link_to "VER TODOS", daily_reports_path(view: "week", date: @daily_report.report_date.strftime("%Y-%m-%d")), class: "nav-link" %>
    <%= link_to "EDITAR", edit_daily_report_path(@daily_report), class: "nav-link", data: { turbo_frame: "daily_report_form_panel" } %>
  </section>
</div>
