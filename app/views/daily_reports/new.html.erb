<% frame_id = turbo_frame_request_id.presence || "daily_report_form_content" %>
<% drawer_mode = frame_id == "daily_report_form_panel" %>
<%= turbo_frame_tag frame_id do %>
<% if drawer_mode %>
<%= render "layouts/aws_page_header", title: "NUEVO REPORTE",
  breadcrumbs: [["Home", root_path], ["Reportes", daily_reports_path(view: "week")], ["Nuevo", nil]] %>

<div class="inline-drawer-shell" data-controller="drawer">
  <div class="inline-drawer-backdrop" data-action="click->drawer#close"></div>
  <div class="inline-drawer-panel">
    <button type="button" class="inline-drawer-close" data-action="click->drawer#close"><%= t("common.close") %></button>
<% end %>

<div class="aws-content">
  <div class="chaotic-container" style="max-width: 800px;">
    <div class="aws-card">
      <div class="aws-card-header">
        <h3 class="aws-card-title">Nuevo reporte</h3>
      </div>
      <div style="padding: 24px;">
        <%= form_with(model: @daily_report, data: (drawer_mode ? {} : { turbo_frame: "_top" })) do |f| %>
          <% if @daily_report.errors.any? %>
            <div class="aws-alert aws-alert-danger" style="margin-bottom: 16px;">
              <ul style="margin: 0; padding-left: 20px;">
                <% @daily_report.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="field" data-controller="calendar">
            <%= f.label :report_date, "Fecha" %>
            <%= f.hidden_field :report_date, value: (@daily_report.report_date || Date.today), data: { calendar_target: "input" } %>
            
            <div class="editorial-calendar">
              <div class="calendar-main">
                <button type="button" class="calendar-control" data-action="click->calendar#prevDay">&larr;</button>
                <div class="calendar-display" data-action="click->calendar#togglePicker">
                  <span class="calendar-day" data-calendar-target="displayDay">00</span>
                  <div class="calendar-month-year">
                    <span data-calendar-target="displayMonth">MES</span> / <span data-calendar-target="displayYear">2026</span>
                  </div>
                </div>
                <button type="button" class="calendar-control" data-action="click->calendar#nextDay">&rarr;</button>
              </div>

              <div class="calendar-picker hidden" data-calendar-target="picker">
                <%= select_tag :calendar_month, options_for_select(
                  (0..11).map { |m| [I18n.t("date.month_names")[m+1].upcase, m] }, 
                  (@daily_report.report_date || Date.today).month - 1
                ), data: { action: "change->calendar#selectMonth" } %>
                
                <%= select_tag :calendar_year, options_for_select(
                  (Date.today.year - 5..Date.today.year + 2).to_a, 
                  (@daily_report.report_date || Date.today).year
                ), data: { action: "change->calendar#selectYear" } %>
              </div>
            </div>
            <p style="font-size: 12px; color: var(--aws-text-secondary); margin-top: 8px;">Flechas para días / clic en el número para mes y año</p>
          </div>

          <div class="field">
            <%= f.label :work_title, "¿En qué se está trabajando?" %>
            <%= f.text_field :work_title, placeholder: "Ej. Implementación de reporte diario" %>
          </div>

          <div class="field">
            <%= f.label :worked_by, "Responsable" %>
            <%= f.text_field :worked_by, placeholder: "Ej. Oscar" %>
          </div>

          <div class="field">
            <%= f.label :yesterday, "¿Qué he hecho?" %>
            <p style="font-size: 12px; color: var(--aws-text-secondary); margin: 0 0 4px;">(Escribe una tarea por línea)</p>
            <%= f.text_area :yesterday, placeholder: "• Tarea 1\n• Tarea 2..." %>
          </div>

          <div class="field">
            <%= f.label :today, "¿Qué haré?" %>
            <p style="font-size: 12px; color: var(--aws-text-secondary); margin: 0 0 4px;">(Escribe una tarea por línea)</p>
            <%= f.text_area :today, placeholder: "• Tarea prioritaria\n• Tarea secundaria..." %>
          </div>

          <div class="field">
            <%= f.label :blockers, "¿Hay algún impedimento?" %>
            <%= f.text_field :blockers, placeholder: "¿Algo te detiene?" %>
          </div>

          <div class="field">
            <%= f.label :additional_details, "Detalles adicionales" %>
            <%= f.text_area :additional_details, rows: 4, placeholder: "Notas, reflexiones, etc." %>
          </div>

          <div style="display: flex; gap: 8px; margin-top: 24px;">
            <%= f.submit @daily_report.new_record? ? "Crear reporte" : "Guardar cambios", class: "aws-btn aws-btn-primary", style: "flex: 1;" %>
            <% if drawer_mode %>
              <button type="button" data-action="click->drawer#close" class="aws-btn aws-btn-secondary"><%= t("common.cancel") %></button>
            <% else %>
              <%= link_to t("common.cancel"), daily_reports_path, data: { turbo_frame: "_top" }, class: "aws-btn aws-btn-secondary" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="legacy-content">
<div class="chaotic-container" style="max-width: 800px;">
  <div style="border-bottom: 8px solid var(--ink); margin-bottom: 4rem; padding-bottom: 1rem;">
    <h1 style="font-size: 3.5rem;"><%= @daily_report.new_record? ? t("daily_reports.form.title_new") : t("daily_reports.form.title_edit") %></h1>
  </div>

  <%= form_with(model: @daily_report, data: (drawer_mode ? {} : { turbo_frame: "_top" })) do |f| %>
    <% if @daily_report.errors.any? %>
      <div style="background: #FFEDED; border: 4px solid #D63031; padding: 2rem; margin-bottom: 3rem; color: #D63031;">
        <h2 style="font-size: 1.2rem; margin-bottom: 1rem;">ERRORS / ERRORES:</h2>
        <ul style="font-weight: 700;">
          <% @daily_report.errors.full_messages.each do |message| %>
            <li><%= message.upcase %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <div class="form-group" data-controller="calendar">
      <%= f.label :report_date, "¿DE QUÉ DÍA?" %>
      <%= f.hidden_field :report_date, value: (@daily_report.report_date || Date.today), data: { calendar_target: "input" } %>
      
      <div class="editorial-calendar">
        <div class="calendar-main">
          <button type="button" class="calendar-control" data-action="click->calendar#prevDay">&larr;</button>
          <div class="calendar-display" data-action="click->calendar#togglePicker">
            <span class="calendar-day" data-calendar-target="displayDay">00</span>
            <div class="calendar-month-year">
              <span data-calendar-target="displayMonth">MES</span> / <span data-calendar-target="displayYear">2026</span>
            </div>
          </div>
          <button type="button" class="calendar-control" data-action="click->calendar#nextDay">&rarr;</button>
        </div>

        <div class="calendar-picker hidden" data-calendar-target="picker">
          <%= select_tag :calendar_month, options_for_select(
            (0..11).map { |m| [I18n.t("date.month_names")[m+1].upcase, m] }, 
            (@daily_report.report_date || Date.today).month - 1
          ), data: { action: "change->calendar#selectMonth" } %>
          
          <%= select_tag :calendar_year, options_for_select(
            (Date.today.year - 5..Date.today.year + 2).to_a, 
            (@daily_report.report_date || Date.today).year
          ), data: { action: "change->calendar#selectYear" } %>
        </div>
      </div>
      <p style="font-size: 0.8rem; opacity: 0.6; margin-top: 1rem;">FLECHAS PARA DÍAS / CLIC EN EL NÚMERO PARA MES Y AÑO</p>
    </div>

    <div class="form-group">
      <span class="section-label" style="background: #1f8f5f; color: white;">EN CURSO</span>
      <h2 class="section-title">0. ¿EN QUÉ SE ESTÁ TRABAJANDO?</h2>
      <%= f.text_field :work_title, placeholder: "Ej. Implementación de reporte diario" %>
    </div>

    <div class="form-group">
      <span class="section-label" style="background: #3157d6; color: white;">RESPONSABLE</span>
      <h2 class="section-title">¿QUIÉN LO ESTÁ TRABAJANDO?</h2>
      <%= f.text_field :worked_by, placeholder: "Ej. Oscar" %>
    </div>

    <div class="form-group">
      <span class="section-label">PASADO</span>
      <h2 class="section-title">1. ¿QUÉ HE HECHO?</h2>
      <p style="font-size: 0.8rem; opacity: 0.6; margin-bottom: 0.5rem;">(Escribe una tarea por línea)</p>
      <%= f.text_area :yesterday, placeholder: "• Tarea 1\n• Tarea 2..." %>
    </div>

    <div class="form-group">
      <span class="section-label" style="background: var(--accent-blue); color: white;">PRESENTE</span>
      <h2 class="section-title">2. ¿QUÉ HARÉ?</h2>
      <p style="font-size: 0.8rem; opacity: 0.6; margin-bottom: 0.5rem;">(Escribe una tarea por línea)</p>
      <%= f.text_area :today, placeholder: "• Tarea prioritaria\n• Tarea secundaria..." %>
    </div>

    <div class="form-group">
      <div class="report-section-block">
        <span class="section-label" style="background: var(--ink); color: var(--paper);">BLOQUEOS</span>
        <h2 class="section-title">3. ¿HAY ALGÚN IMPEDIMENTO?</h2>
        <%= f.text_field :blockers, placeholder: "¿Algo te detiene?" %>
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 8rem;">
      <span class="section-label" style="background: #ddd; color: #000;">EXTRAS</span>
      <h2 class="section-title">DETALLES ADICIONALES</h2>
      <%= f.text_area :additional_details, rows: 4, placeholder: "Notas, reflexiones, etc." %>
    </div>

    <div class="form-actions">
      <%= f.submit t("daily_reports.form.submit_new"), class: "btn-chaos", style: "flex: 1;" %>
      <% if drawer_mode %>
        <button type="button" data-action="click->drawer#close" style="font-weight: 900; text-decoration: none; color: #D63031; background: none; border: none; cursor: pointer;"><%= t("common.cancel") %></button>
      <% else %>
        <%= link_to t("common.cancel"), daily_reports_path, data: { turbo_frame: "_top" }, style: "font-weight: 900; text-decoration: none; color: #D63031;" %>
      <% end %>
    </div>

  <% end %>
</div>
</div>

<% if drawer_mode %>
  </div>
</div>
<% end %>
<% end %>
