<div class="weekly-indicators-section">
  <h2>Dashboard Semanal</h2>
  
  <div class="indicators-grid">
    <!-- 1. Hábitos Cumplidos -->
    <div class="indicator-card habits">
      <div class="indicator-icon">HB</div>
      <div class="indicator-content">
        <div class="indicator-number">
          <%= @indicator_habits_completed %>
          <span class="indicator-total">/ <%= @indicator_habits_total %></span>
        </div>
        <div class="indicator-label">Hábitos Cumplidos</div>
        <div class="indicator-subtext">esta semana</div>
      </div>
      <% if @indicator_habits_total.positive? %>
        <div class="indicator-progress">
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= (@indicator_habits_completed.to_f / @indicator_habits_total.to_f * 100).round(1) %>%"></div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- 2. Gasto vs Presupuesto -->
    <div class="indicator-card budget">
      <div class="indicator-icon">FN</div>
      <div class="indicator-content">
        <div class="indicator-number">
          L. <%= number_with_precision(@indicator_month_expenses, precision: 2) %>
        </div>
        <div class="indicator-label">Gasto vs Presupuesto</div>
        <div class="indicator-subtext">
          <% if @indicator_month_budget.positive? %>
            de L. <%= number_with_precision(@indicator_month_budget, precision: 2) %>
          <% else %>
            (sin presupuesto)
          <% end %>
        </div>
      </div>
      <% if @indicator_month_budget.positive? %>
        <div class="indicator-progress">
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= [@indicator_budget_percent, 100].min %>%; background-color: <%= @indicator_budget_percent > 100 ? '#dc3545' : '#28a745' %>;"></div>
          </div>
          <div class="progress-text"><%= @indicator_budget_percent %>%</div>
        </div>
      <% end %>
    </div>

    <!-- 3. Tareas Cerradas -->
    <div class="indicator-card tasks">
      <div class="indicator-icon">TK</div>
      <div class="indicator-content">
        <div class="indicator-number"><%= @indicator_tasks_completed %></div>
        <div class="indicator-label">Tareas Cerradas</div>
        <div class="indicator-subtext">esta semana</div>
      </div>
    </div>

    <!-- 4. Bloqueos Abiertos -->
    <div class="indicator-card blockers">
      <div class="indicator-icon">BL</div>
      <div class="indicator-content">
        <div class="indicator-number"><%= @indicator_open_blockers %></div>
        <div class="indicator-label">Bloqueos Abiertos</div>
        <% if @indicator_open_blockers.positive? %>
          <div class="indicator-subtext warning">requieren atención</div>
        <% else %>
          <div class="indicator-subtext">resueltos</div>
        <% end %>
      </div>
    </div>

    <!-- 5. Reportes Enviados -->
    <div class="indicator-card reports">
      <div class="indicator-icon">RP</div>
      <div class="indicator-content">
        <div class="indicator-number">
          <%= @indicator_reports_sent %>
          <span class="indicator-total">/ <%= @indicator_reports_target %></span>
        </div>
        <div class="indicator-label">Reportes Enviados</div>
        <div class="indicator-subtext">esta semana</div>
      </div>
      <div class="indicator-progress">
        <div class="progress-bar">
          <div class="progress-fill" style="width: <%= (@indicator_reports_sent.to_f / @indicator_reports_target.to_f * 100).round(1) %>%"></div>
        </div>
      </div>
    </div>

    <!-- 6. Balance Semanal -->
    <div class="indicator-card balance <%= @indicator_weekly_balance >= 0 ? 'positive' : 'negative' %>">
      <div class="indicator-icon"><%= @indicator_weekly_balance >= 0 ? 'UP' : 'DN' %></div>
      <div class="indicator-content">
        <div class="indicator-number">
          L. <%= number_with_precision(@indicator_weekly_balance.abs, precision: 2) %>
        </div>
        <div class="indicator-label">Balance Semanal</div>
        <div class="indicator-subtext">
          <%= @indicator_weekly_balance >= 0 ? 'Ganancia' : 'Pérdida' %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .weekly-indicators-section {
    margin: 2rem 0;
  }

  .weekly-indicators-section h2 {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.35rem;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .indicators-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .indicator-card {
    grid-column: span 6;
    border: 4px solid var(--ink);
    background: var(--muted-gray);
    padding: 1rem;
    box-shadow: 6px 6px 0 var(--highlight);
    display: grid;
    gap: 0.75rem;
  }

  .indicator-card.blockers,
  .indicator-card.balance.negative {
    border-color: #d63031;
  }

  .indicator-card.balance.positive {
    border-color: #2d5a27;
  }

  .indicator-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-width: 2.4rem;
    padding: 0.2rem 0.4rem;
    border: 3px solid var(--ink);
    background: var(--paper);
    font-family: 'Archivo Black', sans-serif;
    font-size: 0.95rem;
  }

  .indicator-content {
    display: grid;
    gap: 0.25rem;
  }

  .indicator-number {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.6rem;
    line-height: 1;
  }

  .indicator-total {
    font-size: 0.85rem;
    font-weight: 900;
  }

  .indicator-label {
    font-size: 0.8rem;
    letter-spacing: 1px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .indicator-subtext {
    font-size: 0.78rem;
    opacity: 0.75;
  }

  .indicator-subtext.warning {
    color: #d63031;
    font-weight: 900;
    opacity: 1;
  }

  .indicator-progress {
    display: grid;
    gap: 0.35rem;
  }

  .progress-bar {
    background: var(--paper);
    border: 3px solid var(--ink);
    height: 12px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent-blue);
    transition: width 0.2s ease;
  }

  .progress-text {
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .indicator-card {
      grid-column: span 12;
    }
  }
</style>
