<%= render "layouts/aws_page_header", title: t('.title'),
  breadcrumbs: [["Home", root_path], ["Chat", chat_rooms_path], ["Nueva sala", nil]] %>

<div class="chaotic-container">
  <h1 style="font-size: 2.5rem; margin-bottom: 2rem;"><%= t('.title') %></h1>

  <%= form_with model: @chat_room, class: "chaotic-form" do |f| %>
    <% if @chat_room.errors.any? %>
      <div style="margin-bottom: 1.5rem; padding: 1rem; border: 3px solid #c00; background: #fee;">
        <p style="font-weight: 700; margin: 0 0 0.5rem;"><%= t('.errors') %></p>
        <ul style="margin: 0; padding-left: 1.2rem;">
          <% @chat_room.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 1.5rem;">
      <%= f.label :name, t('.name_label'), style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.text_field :name, required: true, style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem;" %>
    </div>

    <div style="margin-bottom: 1.5rem;">
      <%= f.label :description, t('.desc_label'), style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.text_area :description, rows: 3, style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem; resize: vertical;" %>
    </div>

    <div style="margin-bottom: 1.5rem;">
      <%= f.label :room_type, t('.type_label'), style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.select :room_type,
          [[t('.type_open'), 'open'], [t('.type_private'), 'private_code'], [t('.type_channel'), 'channel']],
          {},
          { style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem;" }
      %>
    </div>

    <div style="margin-bottom: 1.5rem;">
      <%= f.label :entry_code, t('.entry_code_label'), style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.text_field :entry_code, style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem;" %>
    </div>

    <div style="margin-bottom: 2rem;">
      <%= f.label :capacity, t('.capacity_label'), style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.number_field :capacity, min: 1, style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem;" %>
    </div>

    <div style="display: flex; gap: 1rem;">
      <%= f.submit t('.submit'), class: "btn-chaos", style: "padding: 0.75rem 2rem;" %>
      <%= link_to t('common.cancel'), chat_rooms_path, style: "padding: 0.75rem 2rem; border: 3px solid var(--ink); background: var(--paper); color: var(--ink); text-decoration: none; font-weight: 700; text-transform: uppercase; font-size: 0.8rem;" %>
    </div>
  <% end %>
</div>
