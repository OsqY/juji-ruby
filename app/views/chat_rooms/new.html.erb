<div class="aws-content">
  <%= render "layouts/aws_page_header", title: t('.title'),
    breadcrumbs: [["Home", root_path], ["Chat", chat_rooms_path], ["Nueva sala", nil]] %>

  <div class="aws-card" style="max-width: 600px;">
    <div class="aws-card-header">
      <h3 class="aws-card-title"><%= t('.title') %></h3>
    </div>
    <%= form_with model: @chat_room do |f| %>
      <% if @chat_room.errors.any? %>
        <div class="aws-alert aws-alert-danger" style="margin-bottom: 16px;">
          <p style="font-weight: 700; margin: 0 0 8px;"><%= t('.errors') %></p>
          <ul style="margin: 0; padding-left: 20px;">
            <% @chat_room.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= f.label :name, t('.name_label') %>
        <%= f.text_field :name, required: true %>
      </div>

      <div class="field">
        <%= f.label :description, t('.desc_label') %>
        <%= f.text_area :description, rows: 3 %>
      </div>

      <div class="field">
        <%= f.label :room_type, t('.type_label') %>
        <%= f.select :room_type,
            [[t('.type_open'), 'open'], [t('.type_private'), 'private_code'], [t('.type_channel'), 'channel']]
        %>
      </div>

      <div class="field">
        <%= f.label :entry_code, t('.entry_code_label') %>
        <%= f.text_field :entry_code %>
      </div>

      <div class="field">
        <%= f.label :capacity, t('.capacity_label') %>
        <%= f.number_field :capacity, min: 1 %>
      </div>

      <div style="display: flex; gap: 8px; align-items: center;">
        <%= f.submit t('.submit'), class: "aws-btn aws-btn-primary" %>
        <%= link_to t('common.cancel'), chat_rooms_path, class: "aws-btn aws-btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="legacy-content">
  <div class="chaotic-container">
    <h1 style="font-size: 2.5rem; margin-bottom: 2rem;"><%= t('.title') %></h1>

    <%= form_with model: @chat_room, class: "chaotic-form" do |f| %>
      <% if @chat_room.errors.any? %>
        <div style="background: #FFEDED; border: 4px solid #D63031; padding: 2rem; margin-bottom: 3rem; color: #D63031; font-weight: 700;">
          <p style="font-weight: 700; margin: 0 0 0.5rem;"><%= t('.errors') %></p>
          <ul style="margin: 0; padding-left: 1.2rem;">
            <% @chat_room.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= f.label :name, t('.name_label') %>
        <%= f.text_field :name, required: true %>
      </div>

      <div class="field">
        <%= f.label :description, t('.desc_label') %>
        <%= f.text_area :description, rows: 3 %>
      </div>

      <div class="field">
        <%= f.label :room_type, t('.type_label') %>
        <%= f.select :room_type,
            [[t('.type_open'), 'open'], [t('.type_private'), 'private_code'], [t('.type_channel'), 'channel']]
        %>
      </div>

      <div class="field">
        <%= f.label :entry_code, t('.entry_code_label') %>
        <%= f.text_field :entry_code %>
      </div>

      <div class="field">
        <%= f.label :capacity, t('.capacity_label') %>
        <%= f.number_field :capacity, min: 1 %>
      </div>

      <div class="form-actions">
        <%= f.submit t('.submit'), class: "btn-chaos", style: "flex: 1;" %>
        <%= link_to t('common.cancel'), chat_rooms_path, style: "font-weight: 900; text-decoration: none; color: #D63031;" %>
      </div>
    <% end %>
  </div>
</div>
