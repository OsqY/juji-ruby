<div class="chaotic-container">
  <h1 style="font-size: 2.5rem; margin-bottom: 2rem;">NUEVA SALA</h1>

  <%= form_with model: @chat_room, class: "chaotic-form" do |f| %>
    <% if @chat_room.errors.any? %>
      <div style="margin-bottom: 1.5rem; padding: 1rem; border: 3px solid #c00; background: #fee;">
        <p style="font-weight: 700; margin: 0 0 0.5rem;">Errores:</p>
        <ul style="margin: 0; padding-left: 1.2rem;">
          <% @chat_room.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 1.5rem;">
      <%= f.label :name, "Nombre", style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.text_field :name, required: true, style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem;" %>
    </div>

    <div style="margin-bottom: 1.5rem;">
      <%= f.label :description, "Descripción", style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.text_area :description, rows: 3, style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem; resize: vertical;" %>
    </div>

    <div style="margin-bottom: 1.5rem;">
      <%= f.label :room_type, "Tipo de sala", style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.select :room_type,
          [['Pública', 'open'], ['Privada (por código)', 'private_code'], ['Canal', 'channel']],
          {},
          { style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem;" }
      %>
    </div>

    <div style="margin-bottom: 1.5rem;">
      <%= f.label :entry_code, "Código de acceso (solo para salas privadas)", style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.text_field :entry_code, style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem;" %>
    </div>

    <div style="margin-bottom: 2rem;">
      <%= f.label :capacity, "Capacidad máxima (dejar vacío para ilimitada)", style: "display: block; font-weight: 700; margin-bottom: 0.5rem;" %>
      <%= f.number_field :capacity, min: 1, style: "width: 100%; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem;" %>
    </div>

    <div style="display: flex; gap: 1rem;">
      <%= f.submit "CREAR SALA", class: "btn-chaos", style: "padding: 0.75rem 2rem;" %>
      <%= link_to "CANCELAR", chat_rooms_path, style: "padding: 0.75rem 2rem; border: 3px solid var(--ink); background: var(--paper); color: var(--ink); text-decoration: none; font-weight: 700; text-transform: uppercase; font-size: 0.8rem;" %>
    </div>
  <% end %>
</div>
