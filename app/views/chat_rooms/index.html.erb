<div class="chaotic-container">
  <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 style="font-size: 2.5rem; margin: 0;"><%= t('.title') %></h1>
    <%= link_to t('.new_room'), new_chat_room_path, class: "btn-chaos", style: "padding: 0.75rem 1.5rem; text-decoration: none;" %>
  </div>

  <% if @my_rooms.any? %>
    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #eee;">
        <%= t('.my_rooms') %> <span style="font-size: 0.85rem; color: #999; font-weight: 400;">(<%= @my_rooms.count %>)</span>
      </h2>
      <div style="display: grid; gap: 1rem;">
        <% @my_rooms.each do |room| %>
          <%= render "chat_room_card", room: room, is_member: true %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section style="margin-bottom: 2.5rem;">
    <h2 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #eee;">
      <%= t('.public_rooms') %> <span style="font-size: 0.85rem; color: #999; font-weight: 400;">(<%= @public_rooms.count %>)</span>
    </h2>
    <% if @public_rooms.any? %>
      <div style="display: grid; gap: 1rem;">
        <% @public_rooms.each do |room| %>
          <%= render "chat_room_card", room: room, is_member: false %>
        <% end %>
      </div>
    <% else %>
      <div style="text-align: center; padding: 2rem; color: #666;">
        <p><%= t('.no_public') %></p>
        <%= link_to t('.create_room'), new_chat_room_path, class: "btn-chaos", style: "padding: 0.5rem 1rem; text-decoration: none;" %>
      </div>
    <% end %>
  </section>
</div>
