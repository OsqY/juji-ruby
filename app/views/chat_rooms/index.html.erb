<div class="aws-content">
  <%= render "layouts/aws_page_header", title: t('.title'),
    breadcrumbs: [["Home", root_path], ["Chat", chat_rooms_path]] %>

  <div class="aws-page-header-actions aws-mb-2">
    <%= link_to t('.new_room'), new_chat_room_path, class: "aws-btn aws-btn-primary" %>
  </div>

  <% if @my_rooms.any? %>
    <div class="aws-card aws-mb-2">
      <div class="aws-card-header">
        <h3 class="aws-card-title"><%= t('.my_rooms') %> (<%= @my_rooms.count %>)</h3>
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <% @my_rooms.each do |room| %>
          <%= link_to chat_room_path(room), style: "display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid var(--aws-border); text-decoration: none; color: var(--aws-text-primary); background: #fff; transition: background 0.15s;", onmouseover: "this.style.background='var(--aws-table-hover)'", onmouseout: "this.style.background='#fff'" do %>
            <div>
              <div style="font-weight: 600; font-size: 14px;"><%= room.name %></div>
              <div style="font-size: 12px; color: var(--aws-text-secondary);"><%= room.room_type %> · <%= room.member_count %> miembros</div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--aws-text-secondary);"><path d="m9 18 6-6-6-6"/></svg>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="aws-card">
    <div class="aws-card-header">
      <h3 class="aws-card-title"><%= t('.public_rooms') %> (<%= @public_rooms.count %>)</h3>
    </div>
    <% if @public_rooms.any? %>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <% @public_rooms.each do |room| %>
          <%= link_to chat_room_path(room), style: "display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid var(--aws-border); text-decoration: none; color: var(--aws-text-primary); background: #fff; transition: background 0.15s;", onmouseover: "this.style.background='var(--aws-table-hover)'", onmouseout: "this.style.background='#fff'" do %>
            <div>
              <div style="font-weight: 600; font-size: 14px;"><%= room.name %></div>
              <div style="font-size: 12px; color: var(--aws-text-secondary);"><%= room.room_type %> · <%= room.member_count %> miembros</div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--aws-text-secondary);"><path d="m9 18 6-6-6-6"/></svg>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p style="color: var(--aws-text-secondary); font-size: 14px;"><%= t('.no_public') %></p>
      <%= link_to t('.create_room'), new_chat_room_path, class: "aws-btn aws-btn-primary" %>
    <% end %>
  </div>
</div>

<div class="legacy-content">
  <div class="chaotic-container">
    <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <h1 style="font-size: 2.5rem; margin: 0;"><%= t('.title') %></h1>
      <%= link_to t('.new_room'), new_chat_room_path, class: "btn-chaos", style: "padding: 0.75rem 1.5rem; text-decoration: none;" %>
    </div>

    <% if @my_rooms.any? %>
      <section style="margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #eee;">
          <%= t('.my_rooms') %> <span style="font-size: 0.85rem; color: #999; font-weight: 400;">(<%= @my_rooms.count %>)</span>
        </h2>
        <div style="display: grid; gap: 1rem;">
          <% @my_rooms.each do |room| %>
            <%= render "chat_room_card", room: room, is_member: true %>
          <% end %>
        </div>
      </section>
    <% end %>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #eee;">
        <%= t('.public_rooms') %> <span style="font-size: 0.85rem; color: #999; font-weight: 400;">(<%= @public_rooms.count %>)</span>
      </h2>
      <% if @public_rooms.any? %>
        <div style="display: grid; gap: 1rem;">
          <% @public_rooms.each do |room| %>
            <%= render "chat_room_card", room: room, is_member: false %>
          <% end %>
        </div>
      <% else %>
        <div style="text-align: center; padding: 2rem; color: #666;">
          <p><%= t('.no_public') %></p>
          <%= link_to t('.create_room'), new_chat_room_path, class: "btn-chaos", style: "padding: 0.5rem 1rem; text-decoration: none;" %>
        </div>
      <% end %>
    </section>
  </div>
</div>
