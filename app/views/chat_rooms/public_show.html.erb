<div class="chaotic-container">
  <div style="max-width: 600px; margin: 0 auto; text-align: center;">
    <div style="margin-bottom: 1.5rem;">
      <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0.2rem 0.5rem; border: 2px solid var(--ink); background: var(--muted-gray);">
        <%= @chat_room.room_type %>
      </span>
    </div>
    <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;"><%= @chat_room.name %></h1>
    <p style="color: #666; margin-bottom: 1.5rem;"><%= @chat_room.description || "Sin descripción" %></p>

    <div style="margin-bottom: 2rem;">
      <p style="font-size: 0.9rem; color: #666;">
        Miembros: <strong><%= @chat_room.member_count %></strong>
        <% if @chat_room.capacity.present? %> / <%= @chat_room.capacity %><% end %>
      </p>
    </div>

    <% if @is_member %>
      <%= link_to "ENTRAR A LA SALA", @chat_room, class: "btn-chaos", style: "padding: 0.75rem 2rem; text-decoration: none;" %>
    <% elsif authenticated? && @can_join %>
      <% if @chat_room.private_code? %>
        <%= form_with url: public_chat_room_join_path(token: @chat_room.token), method: :post do |f| %>
          <div style="margin-bottom: 1rem;">
            <%= f.text_field :entry_code,
                placeholder: "Código de acceso",
                required: true,
                style: "width: 100%; max-width: 300px; padding: 0.75rem; border: 3px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); font-size: 1rem; text-align: center;"
            %>
          </div>
          <%= f.submit "UNIRSE", class: "btn-chaos", style: "padding: 0.75rem 2rem;" %>
        <% end %>
      <% else %>
        <%= button_to "UNIRSE A LA SALA", public_chat_room_join_path(token: @chat_room.token), method: :post, class: "btn-chaos", style: "padding: 0.75rem 2rem;" %>
      <% end %>
    <% elsif @chat_room.full? %>
      <div style="padding: 1rem; border: 3px solid #c00; color: #c00; font-weight: 700;">
        Sala llena
      </div>
    <% elsif !authenticated? %>
      <p style="margin-bottom: 1rem;">Inicia sesión para unirte.</p>
      <%= link_to "INICIAR SESIÓN", new_session_path, class: "btn-chaos", style: "padding: 0.75rem 2rem; text-decoration: none;" %>
    <% end %>
  </div>
</div>
