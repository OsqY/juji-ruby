<!-- app/views/errors/mobile_error.html.erb -->
<!-- Error pages optimizadas para Hotwire Native -->

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title><%= @title || "Error" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Archivo Black', 'Inter', sans-serif;
      background-color: #FFFFFF;
      color: #1A1A1A;
      padding: max(20px, env(safe-area-inset-left)) max(20px, env(safe-area-inset-right)) 20px;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-bottom: max(80px, env(safe-area-inset-bottom));
    }

    [data-theme="dark"] {
      background-color: #121212;
      color: #F0F0F0;
    }

    .error-container {
      text-align: center;
      max-width: 500px;
      width: 100%;
    }

    .error-code {
      font-size: clamp(4rem, 20vw, 6rem);
      font-weight: 900;
      line-height: 1;
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: -2px;
    }

    .error-emoji {
      font-size: clamp(3rem, 15vw, 5rem);
      margin-bottom: 1.5rem;
      display: block;
    }

    .error-title {
      font-size: clamp(1.5rem, 4vw, 2rem);
      margin-bottom: 1rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .error-message {
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      opacity: 0.7;
    }

    .error-actions {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .error-action-btn {
      display: inline-block;
      padding: 12px 20px;
      min-height: 48px;
      background-color: #1A1A1A;
      color: #FFFFFF;
      text-decoration: none;
      border: 3px solid #1A1A1A;
      border-radius: 4px;
      font-weight: 900;
      font-size: 0.9rem;
      cursor: pointer;
      -webkit-appearance: none;
      appearance: none;
      transition: all 0.2s;
    }

    [data-theme="dark"] .error-action-btn {
      background-color: #F0F0F0;
      color: #1A1A1A;
      border-color: #F0F0F0;
    }

    .error-action-btn:active {
      transform: translate(2px, 2px);
      box-shadow: none;
    }

    .error-action-btn.secondary {
      background-color: transparent;
      color: #1A1A1A;
    }

    [data-theme="dark"] .error-action-btn.secondary {
      color: #F0F0F0;
    }

    .error-details {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 2px dashed #f0f0f0;
      text-align: left;
    }

    [data-theme="dark"] .error-details {
      border-top-color: #1E1E1E;
    }

    .error-details h3 {
      font-size: 0.8rem;
      font-weight: 900;
      text-transform: uppercase;
      opacity: 0.5;
      margin-bottom: 0.5rem;
    }

    .error-details p {
      font-size: 0.75rem;
      font-family: monospace;
      background-color: #f0f0f0;
      padding: 0.75rem;
      border-radius: 4px;
      overflow-x: auto;
      word-break: break-all;
    }

    [data-theme="dark"] .error-details p {
      background-color: #1E1E1E;
    }
  </style>
</head>
<body>
  <div class="error-container">
    <span class="error-emoji"><%= @emoji || "🚨" %></span>
    <div class="error-code"><%= @code || "Error" %></div>
    <h1 class="error-title"><%= @title || "Algo salió mal" %></h1>
    <p class="error-message"><%= @message || "Por favor, intenta de nuevo o vuelve al inicio" %></p>

    <div class="error-actions">
      <a href="/" class="error-action-btn">← VOLVER AL INICIO</a>
      <button class="error-action-btn secondary" onclick="window.history.back()">← ATRÁS</button>
    </div>

    <% if @details && Rails.env.development? %>
      <div class="error-details">
        <h3>Detalles Técnicos</h3>
        <p><%= @details %></p>
      </div>
    <% end %>
  </div>

  <script>
    // Detect and apply theme
    const theme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', theme);
  </script>
</body>
</html>
