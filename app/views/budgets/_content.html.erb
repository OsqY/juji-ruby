<%= turbo_frame_tag "budgets_content" do %>
  <%= render "shared/frame_flash" %>

  <div class="aws-content">
    <%= render "layouts/aws_page_header", title: "PRESUPUESTOS",
      subtitle: "Planificación mensual",
      breadcrumbs: [["Home", root_path], ["Presupuestos", budgets_path]] %>

    <div class="aws-page-header-actions aws-mb-2">
      <%= render "shared/export_actions", model: "budgets" %>
    </div>

    <div class="aws-card aws-mb-2">
      <div class="aws-card-header">
        <h3 class="aws-card-title">Navegación</h3>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; gap: 8px; align-items: center;">
          <%= link_to "← Mes anterior", budgets_path(month: @previous_month.strftime("%Y-%m")), class: "aws-btn aws-btn-secondary" %>
          <strong style="font-size: 14px;"><%= @selected_month.strftime("%B %Y").upcase %></strong>
          <%= link_to "Mes siguiente →", budgets_path(month: @next_month.strftime("%Y-%m")), class: "aws-btn aws-btn-secondary" %>
        </div>
        <%= link_to "Ir a hoy", budgets_path, class: "aws-btn aws-btn-secondary" %>
      </div>
    </div>

    <div class="aws-widgets-grid aws-mb-2">
      <div class="aws-widget is-success">
        <div class="aws-widget-label">Ingresos del mes</div>
        <div class="aws-widget-value">L. <%= number_with_precision @income, precision: 2 %></div>
        <div class="aws-widget-meta"><%= @selected_month.strftime("%B %Y") %></div>
      </div>
      <div class="aws-widget is-danger">
        <div class="aws-widget-label">Egresos del mes</div>
        <div class="aws-widget-value">L. <%= number_with_precision @expenses, precision: 2 %></div>
        <div class="aws-widget-meta"><%= @selected_month.strftime("%B %Y") %></div>
      </div>
      <div class="aws-widget is-accent">
        <div class="aws-widget-label">Balance neto</div>
        <div class="aws-widget-value">L. <%= number_with_precision @balance, precision: 2 %></div>
        <div class="aws-widget-meta"><%= @selected_month.strftime("%B %Y") %></div>
      </div>
    </div>

    <div class="aws-card aws-mb-2">
      <div class="aws-card-header">
        <h3 class="aws-card-title">Nuevo presupuesto</h3>
      </div>
      <%= form_with model: @budget, url: budgets_path(context: "budgets"), style: "display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end;" do |f| %>
        <%= f.hidden_field :month, value: @selected_month.strftime("%Y-%m-%d") %>
        <div class="field">
          <label>Categoría</label>
          <div data-controller="category-picker">
            <%= f.hidden_field :category, value: @budget.category.to_s.strip.downcase, data: { category_picker_target: "hidden" } %>
            <%= select_tag "budget[category_option]",
              options_for_select([*@category_options.to_a.map { |category| [category, category] }, [t("transactions.category.new"), "__new__"]], @category_options.to_a.include?(@budget.category.to_s.strip.downcase) ? @budget.category.to_s.strip.downcase : "__new__"),
              data: { category_picker_target: "select", action: "change->category-picker#selectChanged", new_value: "__new__" } %>
            <div data-category-picker-target="customWrap" style="margin-top: 4px;">
              <%= text_field_tag "budget[category_custom]", @category_options.to_a.include?(@budget.category.to_s.strip.downcase) ? "" : @budget.category.to_s.strip.downcase, placeholder: t("transactions.category.custom_placeholder"), data: { category_picker_target: "custom", action: "input->category-picker#customChanged" } %>
            </div>
          </div>
        </div>
        <div class="field">
          <label>Límite mensual</label>
          <%= f.number_field :monthly_limit, step: 0.01, min: 0.01, placeholder: "0.00" %>
        </div>
        <%= f.submit "Guardar", class: "aws-btn aws-btn-primary" %>
      <% end %>
    </div>

    <% if @budget_rows.any? %>
      <div class="aws-card">
        <div class="aws-card-header">
          <h3 class="aws-card-title">Presupuestos</h3>
        </div>
        <div style="display: flex; flex-direction: column; gap: 16px; padding: 16px;">
          <% @budget_rows.each do |row| %>
            <% budget = row[:budget] %>
            <% percent = row[:percent] %>
            <% status = row[:status] %>
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 4px;">
                <span style="font-weight: 600;"><%= budget.category.to_s.titleize %></span>
                <span style="color: var(--aws-text-secondary);">L. <%= number_with_precision row[:spent], precision: 2 %> / L. <%= number_with_precision budget.monthly_limit, precision: 2 %></span>
              </div>
              <div style="background: var(--aws-border); height: 8px; overflow: hidden; border-radius: 4px;">
                <div style="background: <%= status == 'danger' ? '#d13212' : status == 'warning' ? '#ff9900' : '#1d8102' %>; height: 100%; width: <%= [percent, 100].min %>%; transition: width 0.3s; border-radius: 4px;"></div>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px; margin-top: 4px; color: var(--aws-text-secondary);">
                <span><%= percent %>% usado</span>
                <div style="display: flex; gap: 8px; align-items: center;">
                  <% if percent >= 100 %>
                    <span class="aws-tag aws-tag-error">Presupuesto superado</span>
                  <% elsif percent >= 80 %>
                    <span class="aws-tag aws-tag-warning">Alerta: 80% alcanzado</span>
                  <% end %>
                  <%= button_to "Eliminar", budget_path(budget, context: "budgets"), method: :delete, class: "aws-btn aws-btn-danger", style: "padding: 2px 8px; font-size: 11px;", data: { turbo_confirm: "¿Eliminar presupuesto?" } %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="aws-empty-state">
        <p class="aws-empty-state-desc">Crea un presupuesto para empezar a monitorear consumo por categoría.</p>
      </div>
    <% end %>
  </div>

  <div class="legacy-content">
    <div class="chaotic-container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; gap: 1rem; flex-wrap: wrap;">
        <h1 style="font-size: 3.6rem;">PRESUPUESTOS</h1>
        <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
          <%= render "shared/export_actions", model: "budgets" %>
        </div>
      </div>

      <section class="report-section-block" style="margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
          <div style="display: flex; gap: 0.5rem; align-items: center;">
            <%= link_to "← MES ANTERIOR", budgets_path(month: @previous_month.strftime("%Y-%m")), class: "nav-link" %>
            <strong style="letter-spacing: 1px;"><%= @selected_month.strftime("%B %Y").upcase %></strong>
            <%= link_to "MES SIGUIENTE →", budgets_path(month: @next_month.strftime("%Y-%m")), class: "nav-link" %>
          </div>
          <%= link_to "IR A HOY", budgets_path, class: "nav-link" %>
        </div>
      </section>

      <div class="report-grid" style="margin-bottom: 2rem;">
        <div class="report-column">
          <div class="report-section-block" style="background: var(--income-bg); color: var(--income-text);">
            <span class="section-label" style="background: var(--income-text); color: var(--income-bg);">INGRESOS DEL MES</span>
            <h2 style="font-size: 2.1rem; margin-top: 0.8rem;">L. <%= number_with_precision @income, precision: 2 %></h2>
          </div>
        </div>
        <div class="report-column">
          <div class="report-section-block" style="background: var(--expense-bg); color: var(--expense-text);">
            <span class="section-label" style="background: var(--expense-text); color: var(--expense-bg);">EGRESOS DEL MES</span>
            <h2 style="font-size: 2.1rem; margin-top: 0.8rem;">L. <%= number_with_precision @expenses, precision: 2 %></h2>
          </div>
        </div>
      </div>

      <section class="report-card" style="margin-bottom: 2.2rem;">
        <div class="daily-header">
          <div class="daily-date">MES</div>
          <div class="daily-metadata">BALANCE NETO</div>
        </div>
        <h2 style="font-size: 3.2rem; letter-spacing: -1px; margin-top: 1rem;">
          L. <%= number_with_precision @balance, precision: 2 %>
        </h2>
      </section>

      <section class="report-section-block" style="margin-bottom: 2rem;">
        <span class="section-label" style="background: var(--accent-blue); color: white;">NUEVO PRESUPUESTO</span>
        <h2 class="section-title" style="margin-top: 1rem;">LÍMITE MENSUAL POR CATEGORÍA</h2>

        <%= form_with model: @budget, url: budgets_path(context: "budgets"), class: "budget-form" do |f| %>
          <%= f.hidden_field :month, value: @selected_month.strftime("%Y-%m-%d") %>
          <% category_options = @category_options.to_a %>
          <% selected_category = @budget.category.to_s.strip.downcase %>
          <% in_options = selected_category.present? && category_options.include?(selected_category) %>
          <% selected_option = in_options ? selected_category : "__new__" %>
          <% custom_value = in_options ? "" : selected_category %>
          <div class="field">
            <label>Categoría</label>
            <div data-controller="category-picker">
              <%= f.hidden_field :category, value: selected_category, data: { category_picker_target: "hidden" } %>
              <%= select_tag "budget[category_option]",
                options_for_select([*category_options.map { |category| [category, category] }, [t("transactions.category.new"), "__new__"]], selected_option),
                  data: { category_picker_target: "select", action: "change->category-picker#selectChanged", new_value: "__new__" } %>

              <div data-category-picker-target="customWrap" style="margin-top: 0.4rem;">
                <%= text_field_tag "budget[category_custom]", custom_value, placeholder: t("transactions.category.custom_placeholder"), data: { category_picker_target: "custom", action: "input->category-picker#customChanged" } %>
              </div>
            </div>
          </div>
          <div class="field">
            <label>Límite mensual</label>
            <%= f.number_field :monthly_limit, step: 0.01, min: 0.01, placeholder: "0.00" %>
          </div>
          <div style="display: flex; align-items: end;">
            <%= f.submit "GUARDAR", class: "btn-chaos", style: "padding: 0.8rem 1rem; font-size: 0.8rem;" %>
          </div>
        <% end %>
      </section>

      <% if @budget_rows.any? %>
        <section class="budget-board">
          <% @budget_rows.each do |row| %>
            <% budget = row[:budget] %>
            <% percent = row[:percent] %>
            <% status = row[:status] %>
            <div class="budget-item budget-<%= status %>">
              <div class="budget-head">
                <strong><%= budget.category.to_s.upcase %></strong>
                <span>L. <%= number_with_precision row[:spent], precision: 2 %> / L. <%= number_with_precision budget.monthly_limit, precision: 2 %></span>
                <span>
                  <%= button_to "ELIMINAR", budget_path(budget, context: "budgets"), method: :delete, data: { turbo_confirm: "¿Eliminar presupuesto?" }, class: "aws-btn aws-btn-danger" %>
                </span>
              </div>
              <div class="budget-track">
                <div class="budget-fill budget-fill-<%= status %>" style="width: <%= [percent, 100].min %>%;"></div>
              </div>
              <div class="budget-foot">
                <span><%= percent %>% USADO</span>
                <% if percent >= 100 %>
                  <span class="budget-alert">SUPERASTE EL PRESUPUESTO</span>
                <% elsif percent >= 80 %>
                  <span class="budget-alert">ALERTA: 80% ALCANZADO</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </section>
      <% else %>
        <div class="aws-empty-state">
          <p class="aws-empty-state-desc">Crea un presupuesto para empezar a monitorear consumo por categoría.</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
