<div class="chaotic-container" style="max-width: 100%;">
  <div
    data-controller="whiteboard"
    data-whiteboard-id-value="<%= @whiteboard.id %>"
    data-whiteboard-token-value="<%= @whiteboard.token %>"
    data-whiteboard-user-id-value="<%= current_user&.id || 'guest' %>"
    data-whiteboard-width-value="<%= @whiteboard.width %>"
    data-whiteboard-height-value="<%= @whiteboard.height %>"
    data-whiteboard-bg-value="<%= @whiteboard.background_color %>"
    data-whiteboard-strokes-value="<%= @strokes.map { |s| { stroke: s.stroke_data, user_id: s.user_id, stroke_id: s.id } }.to_json %>"
    style="display: flex; flex-direction: column; gap: 1rem;"
  >
    <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap;">
      <div>
        <h1 style="font-size: 2.4rem;"><%= @whiteboard.name.upcase %></h1>
        <p style="font-weight: 700; opacity: 0.6; font-size: 0.85rem;">
          <%= @whiteboard.width %>x<%= @whiteboard.height %> | <%= @whiteboard.whiteboard_strokes.count %> TRAZOS
        </p>
      </div>
      <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
        <button type="button" class="btn-chaos" style="padding: 0.7rem 1rem; font-size: 0.8rem;" data-action="click->whiteboard#copyLink">COPIAR LINK</button>
        <button type="button" class="btn-chaos" style="padding: 0.7rem 1rem; font-size: 0.8rem;" data-action="click->whiteboard#exportPng">EXPORTAR PNG</button>
        <% if @whiteboard.user_id == current_user&.id %>
          <%= button_to "ELIMINAR", whiteboard_path(@whiteboard), method: :delete, class: "delete-btn-link", style: "padding: 0.7rem 1rem; font-size: 0.8rem;", data: { turbo_confirm: "¿Eliminar esta pizarra?" } %>
        <% end %>
      </div>
    </div>
    <!-- Toolbar -->
    <div class="report-section-block" style="padding: 1rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
        <button type="button" class="btn-chaos" style="padding: 0.5rem 0.8rem; font-size: 0.75rem;" data-whiteboard-target="toolBtn" data-tool="pen" data-action="click->whiteboard#setTool">LÁPIZ</button>
        <button type="button" class="btn-chaos" style="padding: 0.5rem 0.8rem; font-size: 0.75rem;" data-whiteboard-target="toolBtn" data-tool="line" data-action="click->whiteboard#setTool">LÍNEA</button>
        <button type="button" class="btn-chaos" style="padding: 0.5rem 0.8rem; font-size: 0.75rem;" data-whiteboard-target="toolBtn" data-tool="arrow" data-action="click->whiteboard#setTool">FLECHA</button>
        <button type="button" class="btn-chaos" style="padding: 0.5rem 0.8rem; font-size: 0.75rem;" data-whiteboard-target="toolBtn" data-tool="rect" data-action="click->whiteboard#setTool">RECT</button>
        <button type="button" class="btn-chaos" style="padding: 0.5rem 0.8rem; font-size: 0.75rem;" data-whiteboard-target="toolBtn" data-tool="circle" data-action="click->whiteboard#setTool">CÍRCULO</button>
        <button type="button" class="btn-chaos" style="padding: 0.5rem 0.8rem; font-size: 0.75rem; background: var(--paper); color: var(--ink);" data-whiteboard-target="toolBtn" data-tool="eraser" data-action="click->whiteboard#setTool">GOMA</button>
      </div>

      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <input type="color" data-whiteboard-target="colorPicker" data-action="change->whiteboard#setColor" value="#000000" style="width: 40px; height: 40px; padding: 0; border: 3px solid var(--ink); cursor: pointer;">
      </div>

      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <label style="font-size: 0.7rem; font-weight: 900;">GROSOR</label>
        <input type="range" data-whiteboard-target="widthSlider" data-action="change->whiteboard#setWidth" min="1" max="20" value="3" style="width: 100px;">
      </div>

      <div style="margin-left: auto; display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button type="button" class="btn-chaos" style="padding: 0.5rem 0.8rem; font-size: 0.75rem;" data-action="click->whiteboard#undo">DESHACER</button>
        <button type="button" class="btn-chaos" style="padding: 0.5rem 0.8rem; font-size: 0.75rem;" data-action="click->whiteboard#redo">REHACER</button>
        <button type="button" class="btn-chaos" style="padding: 0.5rem 0.8rem; font-size: 0.75rem; background: var(--expense-bg); color: var(--expense-text);" data-action="click->whiteboard#clear">LIMPIAR</button>
      </div>
    </div>

    <!-- Canvas Container -->
    <div style="border: 4px solid var(--ink); overflow: auto; background: var(--muted-gray); position: relative;">
      <canvas
        data-whiteboard-target="canvas"
        data-action="mousedown->whiteboard#startDrawing mousemove->whiteboard#draw mouseup->whiteboard#stopDrawing mouseleave->whiteboard#stopDrawing touchstart->whiteboard#startDrawing touchmove->whiteboard#draw touchend->whiteboard#stopDrawing"
        style="display: block; cursor: crosshair; touch-action: none;"
      ></canvas>
      <canvas
        data-whiteboard-target="overlay"
        style="position: absolute; top: 0; left: 0; pointer-events: none; display: block;"
      ></canvas>
    </div>

    <p data-whiteboard-target="status" style="font-size: 0.75rem; font-weight: 700; opacity: 0.6; margin: 0;"></p>
  </div>
</div>
