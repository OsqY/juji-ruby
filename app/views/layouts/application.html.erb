<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Juji" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Juji">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="theme frame-state">
    <nav class="chaos-nav" data-controller="nav-dropdown" data-action="click->nav-dropdown#closeOnLinkClick">
      <% dashboard_active = controller_name == "dashboard" %>
      <% reports_active = controller_name == "daily_reports" && action_name != "new" %>
      <% report_new_active = controller_name == "daily_reports" && action_name == "new" %>
      <% finance_active = controller_name == "transactions" && action_name != "new" %>
      <% finance_new_active = controller_name == "transactions" && action_name == "new" %>
      <% projects_active = controller_name == "projects" %>
      <% habits_active = controller_name == "habits" %>
      <% budgets_active = controller_name == "budgets" %>
      <% shopping_active = controller_name == "shopping_items" %>
      <% forms_active = controller_name == "anonymous_forms" %>
      <% guide_active = controller_name == "guides" %>
      <% login_active = controller_name == "sessions" && action_name == "new" %>
      <% register_active = controller_name == "registrations" && action_name == "new" %>
      <% recovery_active = controller_name == "passwords" && action_name == "new" %>

      <div class="nav-brand">
        <%= link_to "JUJI", root_path, class: "brand-mark" %>
        <span class="brand-tag">archivo personal</span>
      </div>

      <% reports_group_active = reports_active || report_new_active %>
      <% productivity_group_active = projects_active || habits_active || shopping_active %>
      <% finance_group_active = finance_active || finance_new_active || budgets_active %>
      <% account_group_active = login_active || register_active || recovery_active %>

      <div class="nav-primary" role="navigation" aria-label="Secciones principales">
        <%= link_to "DASHBOARD", dashboard_path, class: "nav-link #{'is-active' if dashboard_active}" %>
        <%= link_to t("guide.nav"), guide_path, class: "nav-link #{'is-active' if guide_active}" %>
        <%= link_to "FORMULARIOS", anonymous_forms_path, class: "nav-link #{'is-active' if forms_active}" %>

        <details class="nav-dropdown" data-nav-dropdown-target="group" data-action="toggle->nav-dropdown#handleToggle">
          <summary class="nav-link nav-dropdown-toggle <%= 'is-active' if reports_group_active %>">REPORTES</summary>
          <div class="nav-dropdown-menu" role="menu" aria-label="Sección reportes">
            <%= link_to "VER REPORTES", daily_reports_path, class: "nav-link #{'is-active' if reports_active}", role: "menuitem" %>
            <%= link_to "NUEVO REPORTE", new_daily_report_path, class: "nav-link nav-link-create #{'is-active' if report_new_active}", role: "menuitem" %>
          </div>
        </details>

        <details class="nav-dropdown" data-nav-dropdown-target="group" data-action="toggle->nav-dropdown#handleToggle">
          <summary class="nav-link nav-dropdown-toggle <%= 'is-active' if productivity_group_active %>">PRODUCTIVIDAD</summary>
          <div class="nav-dropdown-menu" role="menu" aria-label="Sección productividad">
            <%= link_to "PROYECTOS", projects_path, class: "nav-link #{'is-active' if projects_active}", role: "menuitem" %>
            <%= link_to "HÁBITOS", habits_path, class: "nav-link #{'is-active' if habits_active}", role: "menuitem" %>
            <%= link_to "COMPRAS", shopping_items_path, class: "nav-link #{'is-active' if shopping_active}", role: "menuitem" %>
          </div>
        </details>

        <details class="nav-dropdown" data-nav-dropdown-target="group" data-action="toggle->nav-dropdown#handleToggle">
          <summary class="nav-link nav-dropdown-toggle <%= 'is-active' if finance_group_active %>">FINANZAS</summary>
          <div class="nav-dropdown-menu" role="menu" aria-label="Sección finanzas">
            <%= link_to "VER FINANZAS", transactions_path, class: "nav-link #{'is-active' if finance_active}", role: "menuitem" %>
            <%= link_to "NUEVA TRANSACCIÓN", new_transaction_path, class: "nav-link nav-link-create #{'is-active' if finance_new_active}", role: "menuitem" %>
            <%= link_to "PRESUPUESTOS", budgets_path, class: "nav-link #{'is-active' if budgets_active}", role: "menuitem" %>
          </div>
        </details>
      </div>

      <div class="nav-meta" role="navigation" aria-label="Cuenta">
        <details class="nav-dropdown nav-dropdown-account" data-nav-dropdown-target="group" data-action="toggle->nav-dropdown#handleToggle">
          <summary class="nav-link nav-dropdown-toggle <%= 'is-active' if account_group_active %>">
            <%= authenticated? ? "CUENTA" : "ACCESO" %>
          </summary>
          <div class="nav-dropdown-menu nav-account-menu" role="menu" aria-label="Menú de cuenta">
            <% if authenticated? %>
              <div class="nav-user nav-user-menu"><%= current_user.email_address %></div>
              <%= button_to "SALIR", session_path, method: :delete, class: "nav-logout-btn nav-logout-btn-menu" %>
            <% else %>
              <%= link_to "ENTRAR", new_session_path, class: "nav-link nav-link-soft #{'is-active' if login_active}", role: "menuitem" %>
              <%= link_to "REGISTRARME", new_registration_path, class: "nav-link nav-link-solid #{'is-active' if register_active}", role: "menuitem" %>
              <%= link_to "RECUPERAR", new_password_path, class: "nav-link nav-link-soft #{'is-active' if recovery_active}", role: "menuitem" %>
            <% end %>
          </div>
        </details>

        <div class="theme-picker theme-picker-compact">
        <label class="theme-option" title="Modo Claro" for="theme_light">
          <input type="radio" name="theme" id="theme_light" value="light" data-action="change->theme#switch">
          <i data-lucide="sun"></i>
        </label>
        <label class="theme-option" title="Modo Oscuro" for="theme_dark">
          <input type="radio" name="theme" id="theme_dark" value="dark" data-action="change->theme#switch">
          <i data-lucide="moon"></i>
        </label>
        <label class="theme-option" title="Vintage" for="theme_vintage">
          <input type="radio" name="theme" id="theme_vintage" value="vintage" data-action="change->theme#switch">
          <i data-lucide="palette"></i>
        </label>
        <label class="theme-option" title="Neon" for="theme_neon">
          <input type="radio" name="theme" id="theme_neon" value="neon" data-action="change->theme#switch">
          <i data-lucide="zap"></i>
        </label>
      </div>
      </div>
    </nav>
    <main class="chaotic-container" style="padding-top: 6rem;">
      <%= yield %>
    </main>
  </body>
</html>
