<div id="message_<%= message.id %>"
     style="margin-bottom: 0.75rem; padding: 0.75rem; border: 2px solid <%= message.system_message? ? '#ccc' : 'var(--ink)' %>; background: <%= message.system_message? ? 'var(--muted-gray)' : 'var(--paper)' %>;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
    <span style="font-weight: 700; font-size: 0.85rem;">
      <%= message.system_message? ? "Sistema" : message.author_name %>
    </span>
    <span style="font-size: 0.75rem; color: #666;">
      <%= message.created_at.strftime("%H:%M") %>
    </span>
  </div>
  <div style="font-size: 0.95rem; word-break: break-word;">
    <%= message.content %>
  </div>
</div>
